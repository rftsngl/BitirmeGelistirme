{
  "Agent": {
    "MaxSteps": 5,
    "MaxPriorStepsInPrompt": 5,
    "SystemPrompt": "You are a Windows desktop assistant. Follow the user message format exactly and output only the requested JSON decision object.",
    "Model": {
      "Provider": "OpenAICompatible",
      "BaseUrl": "https://api.openai.com/v1",
      "Endpoint": "/chat/completions",
      "Model": "gpt-4o-mini",
      "ApiKeyEnvironmentVariable": "OPENAI_API_KEY",
      "RequestTimeoutSeconds": 120
    }
  },
  "Runtime": {
    "LogsDirectory": "logs/runs",
    "ScreenshotsDirectory": "logs/screenshots"
  }
}
