{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "ExecutionPolicy": {
    "AllowedRealApps": [
      "notepad",
      "calc"
    ],
    "AllowedExecutablePaths": [
      "C:\\Windows\\System32\\notepad.exe"
    ],
    "AppAliases": {
      "calculator": "calc"
    },
    "RequiresApprovalTargets": [
      "powershell",
      "cmd",
      "regedit",
      "registry editor"
    ],
    "RequiresApprovalTextPatterns": [
      "password",
      "api key",
      "token",
      "secret"
    ],
    "RequiresApprovalShortcutPatterns": [
      "alt+f4",
      "win+r",
      "ctrl+shift+esc"
    ],
    "DeniedPatterns": [
      "delete",
      "system32",
      "format",
      "shutdown",
      "remove registry"
    ]
  },
  "ModelDecision": {
    "Enabled": true,
    "RuntimeSliceFallbackPolicy": "FailClosed",
    "ActiveProfile": "default-openai-compatible",
    "Profiles": [
      {
        "Id": "default-openai-compatible",
        "Kind": "OpenAICompatible",
        "DisplayName": "Default OpenAI-Compatible",
        "BaseUrl": "https://api.openai.com/v1",
        "Model": "gpt-4.1-mini",
        "EndpointStyle": "OpenAiChatCompletions",
        "EndpointPath": "chat/completions",
        "RequiresApiKey": true,
        "ApiKeyEnvVar": "OPENAI_API_KEY",
        "ApiKeyHeaderName": "Authorization",
        "AuthScheme": "Bearer",
        "IsEnabled": true
      },
      {
        "Id": "example-gemini-native",
        "Kind": "Gemini",
        "DisplayName": "Example Gemini (native generateContent)",
        "BaseUrl": "https://generativelanguage.googleapis.com/",
        "Model": "gemini-2.0-flash",
        "EndpointStyle": "Unsupported",
        "EndpointPath": "v1beta/models/gemini-2.0-flash:generateContent",
        "RequiresApiKey": true,
        "ApiKeyEnvVar": "GEMINI_API_KEY",
        "ApiKeyHeaderName": "x-goog-api-key",
        "AuthScheme": "Raw",
        "IsEnabled": false
      }
    ],
    "TimeoutMilliseconds": 10000
  }
}
