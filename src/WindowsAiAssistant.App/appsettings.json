{
  "Agent": {
    "MaxSteps": 10,
    "MaxPriorStepsInPrompt": 10,
    "SystemPrompt": "You are an autonomous Windows desktop operator. TOOL PRIORITY: (1) built-in integration actions, (2) open_app/open_url/launch, (3) shell, (4) UI automation only for explicit in-app UI work or after higher tiers fail. Never simulate system tasks (volume, network, services, packages) via UI clicks. For conversation-only goals use respond/complete. Never automate the assistant's own window or voice overlay. Output strict JSON only; user messages in Turkish.",
    "Model": {
      "Provider": "OpenAICompatible",
      "BaseUrl": "https://api.openai.com/v1",
      "Endpoint": "/chat/completions",
      "Model": "gpt-4o-mini",
      "ApiKeyEnvironmentVariable": "OPENAI_API_KEY",
      "RequestTimeoutSeconds": 120
    }
  },
  "Runtime": {
    "LogsDirectory": "logs/runs",
    "ScreenshotsDirectory": "logs/screenshots",
    "UiAutomation": {
      "MaxDepth": 4,
      "MaxElementsPerStep": 80,
      "CaptureTimeoutMs": 8000,
      "EnableChromiumAccessibility": true,
      "EnableUia2Fallback": true,
      "Uia2FallbackMinElements": 3
    },
    "ActionPolicy": {
      "Normal": "Allow",
      "Sensitive": "RequireApproval",
      "Destructive": "RequireApproval",
      "AllowSessionRemember": false
    }
  },
  "Audio": {
    "BackgroundModeEnabled": true,
    "StartMinimizedToTray": true,
    "WakeWordEnabled": true,
    "WakeWordEngine": "vosk",
    "WakeWordPhrase": "asistan",
    "GlobalHotKeyEnabled": true,
    "GlobalHotKey": "Ctrl+Alt+A",
    "TextToSpeechEnabled": true,
    "TtsEngine": "edge",
    "TtsVoiceName": "tr-TR-EmelNeural",
    "TtsSpeakingRate": 1.0,
    "SpeechLanguage": "tr-TR",
    "SpeechListenTimeoutSeconds": 10,
    "SilenceEndMilliseconds": 1400,
    "VadSpeechMultiplier": 3.2,
    "VadMinSpeechMilliseconds": 380,
    "VadCalibrationMilliseconds": 500,
    "MicGainTargetPeak": 0.55,
    "SttMinTranscriptCharacters": 2,
    "WakeWordFinalOnly": true,
    "WakeWordCooldownSeconds": 8,
    "WakeWordRequireSpeechEnergy": true,
    "WakeWordMinPeakLevel": 0.011,
    "FollowUpListenTimeoutSeconds": 12,
    "OverlayAutoCloseSeconds": 10,
    "StartWithWindows": false,
    "VoiceApprovalEnabled": true,
    "SpeechEngine": "whisper",
    "WhisperModelVariant": "medium",
    "WhisperModelPath": "",
    "VoskModelVariant": "small",
    "VoskModelPath": "",
    "InputDeviceIndex": -1
  }
}
