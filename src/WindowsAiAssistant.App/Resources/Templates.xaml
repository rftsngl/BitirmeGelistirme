<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WindowsAiAssistant.App.Converters"
    xmlns:templates="using:WindowsAiAssistant.App.Templates"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <converters:RiskLevelToBrushConverter x:Key="RiskLevelToBrushConverter" />
    <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
    <converters:BoolToSuccessBrushConverter x:Key="BoolToSuccessBrushConverter" />
    <converters:FilePathToImageSourceConverter x:Key="FilePathToImageSourceConverter" />
    <converters:SpeechModelStateToBackgroundBrushConverter x:Key="SpeechModelStateToBackgroundBrushConverter" />
    <converters:SpeechModelStateToForegroundBrushConverter x:Key="SpeechModelStateToForegroundBrushConverter" />

    <DataTemplate x:Key="PlanStepTemplate">
        <Grid ColumnSpacing="10" Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Ellipse Grid.Column="0"
                     Width="8"
                     Height="8"
                     Fill="{ThemeResource TextFillColorSecondaryBrush}"
                     Opacity="0.45"
                     VerticalAlignment="Top"
                     Margin="0,5,0,0"
                     Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibilityConverter}}" />
            <FontIcon Grid.Column="0"
                      Glyph="&#xE768;"
                      FontFamily="{StaticResource SymbolThemeFontFamily}"
                      FontSize="12"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                      VerticalAlignment="Top"
                      Margin="0,2,0,0"
                      Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}" />
            <FontIcon Grid.Column="0"
                      Glyph="&#xE73E;"
                      FontFamily="{StaticResource SymbolThemeFontFamily}"
                      FontSize="12"
                      Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                      VerticalAlignment="Top"
                      Margin="0,2,0,0"
                      Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock Grid.Column="1"
                       Text="{Binding StepLabel}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                       TextWrapping="WrapWholeWords"
                       Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock Grid.Column="1"
                       Text="{Binding StepLabel}"
                       FontSize="13"
                       TextWrapping="WrapWholeWords"
                       Opacity="0.88"
                       Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="TimelineEntryTemplate">
        <Grid ColumnSpacing="10" Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <muxc:ProgressRing Grid.Column="0"
                               Width="14"
                               Height="14"
                               IsActive="True"
                               Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}" />
            <FontIcon Grid.Column="0"
                      Glyph="&#xE73E;"
                      FontFamily="{StaticResource SymbolThemeFontFamily}"
                      FontSize="12"
                      Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                      Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibilityConverter}}" />
            <FontIcon Grid.Column="0"
                      Glyph="&#xE783;"
                      FontFamily="{StaticResource SymbolThemeFontFamily}"
                      FontSize="12"
                      Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                      Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibilityConverter}}" />
            <StackPanel Grid.Column="1" Spacing="1">
                <TextBlock Text="{Binding Label}" FontSize="13" Opacity="0.92" />
                <TextBlock Text="{Binding Detail}"
                           Style="{StaticResource SettingDescriptionTextBlockStyle}"
                           Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="UserMessageTemplate">
        <Grid Margin="0,6,0,6" HorizontalAlignment="Stretch">
            <Grid HorizontalAlignment="Right" MaxWidth="820">
                <Border Style="{StaticResource ChatUserBubbleStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Body}"
                                   Style="{StaticResource ChatBodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding TimestampDisplay}"
                                   Style="{StaticResource ChatMetaTextBlockStyle}"
                                   HorizontalAlignment="Right"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="LiveActivityTemplate">
        <Grid Margin="0,6,0,6" HorizontalAlignment="Stretch">
            <Grid HorizontalAlignment="Left" MaxWidth="820">
                <Border Style="{StaticResource LiveActivityBubbleStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="34" Height="34">
                                <muxc:ProgressRing Width="34"
                                                   Height="34"
                                                   IsActive="{Binding IsActive}" />
                                <FontIcon Glyph="&#xE99A;"
                                          FontFamily="{StaticResource SymbolThemeFontFamily}"
                                          FontSize="15"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Opacity="0.85" />
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Asistan çalışıyor"
                                           Style="{StaticResource ChatMetaTextBlockStyle}" />
                                <TextBlock Text="{Binding LiveStatusLine}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextWrapping="WrapWholeWords"
                                           MaxLines="2" />
                            </StackPanel>
                            <Border Grid.Column="2"
                                    Style="{StaticResource LiveActivityPillBorderStyle}"
                                    Visibility="{Binding StepProgressDisplay, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                <TextBlock Text="{Binding StepProgressDisplay}"
                                           Style="{StaticResource ChatMetaTextBlockStyle}"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding LiveDetailLine}"
                                   Style="{StaticResource SettingDescriptionTextBlockStyle}"
                                   Visibility="{Binding HasLiveDetail, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <Border Style="{StaticResource PlanPanelBorderStyle}"
                                Visibility="{Binding HasPlanPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8FD;"
                                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                                              FontSize="14"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="Yürütme planı"
                                               Style="{StaticResource LabelTextBlockStyle}"
                                               VerticalAlignment="Center"
                                               Opacity="0.92" />
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                VerticalAlignment="Center">
                                        <Border Style="{StaticResource PlanSkillBadgeBorderStyle}"
                                                Visibility="{Binding HasSkillDomainLabel, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding SkillDomainLabel}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource PlanRevisionBadgeBorderStyle}"
                                                Visibility="{Binding HasPlanRevisionLabel, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding PlanRevisionLabel}"
                                                       FontSize="11"
                                                       Opacity="0.85" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding PlanHeadline}"
                                           FontSize="13"
                                           TextWrapping="WrapWholeWords"
                                           Visibility="{Binding HasPlanHeadline, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock Text="{Binding PlanProgressLine}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           TextWrapping="WrapWholeWords"
                                           Visibility="{Binding HasPlanProgressLine, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <ItemsControl ItemsSource="{Binding PlanSteps}"
                                              ItemTemplate="{StaticResource PlanStepTemplate}"
                                              Visibility="{Binding HasPlanSteps, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Ellipse Style="{StaticResource ThinkingDotStyle}" Opacity="0.45" />
                            <Ellipse Style="{StaticResource ThinkingDotStyle}" Opacity="0.7" />
                            <Ellipse Style="{StaticResource ThinkingDotStyle}" />
                            <TextBlock Text="Canlı akış"
                                       Style="{StaticResource ChatMetaTextBlockStyle}"
                                       Margin="4,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Spacing="6"
                                    Visibility="{Binding HasTimeline, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Akış" Style="{StaticResource LabelTextBlockStyle}" />
                            <ItemsControl ItemsSource="{Binding Timeline}"
                                          ItemTemplate="{StaticResource TimelineEntryTemplate}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="AssistantStatusTemplate">
        <Grid Margin="0,6,0,6" HorizontalAlignment="Stretch">
            <Grid HorizontalAlignment="Left" MaxWidth="820">
                <Border Style="{StaticResource ChatAssistantBubbleStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{Binding Body}" Style="{StaticResource ChatBodyTextBlockStyle}" Opacity="0.9" />
                        <TextBlock Text="{Binding TimestampDisplay}" Style="{StaticResource ChatMetaTextBlockStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="PendingApprovalTemplate">
        <Grid Margin="0,6,0,6" HorizontalAlignment="Stretch">
            <Grid HorizontalAlignment="Left" MaxWidth="820">
                <Border Style="{StaticResource CardBorderStyle}"
                        BorderBrush="{ThemeResource SystemFillColorCautionBrush}">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7BA;"
                                      FontFamily="{StaticResource SymbolThemeFontFamily}"
                                      Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Title}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextWrapping="WrapWholeWords" />
                            <Border Grid.Column="2"
                                    Style="{StaticResource BadgeBorderStyle}"
                                    Background="{Binding StatusBadge, Converter={StaticResource StatusToBrushConverter}}">
                                <TextBlock Text="{Binding StatusBadge}"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="11" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding Body}" Style="{StaticResource ChatBodyTextBlockStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6"
                                        Visibility="{Binding DeveloperModeEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="İşlem" />
                                <TextBlock Text="{Binding SelectedTool}" FontSize="13" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="Risk" />
                                <Border Style="{StaticResource BadgeBorderStyle}"
                                        Background="{Binding RiskLevel, Converter={StaticResource RiskLevelToBrushConverter}}">
                                    <TextBlock Text="{Binding RiskLevel}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="{Binding IsApprovalActionable, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button Style="{ThemeResource AccentButtonStyle}"
                                    Content="{Binding PrimaryCommandLabel}"
                                    Command="{Binding PrimaryCommand}" />
                            <Button Content="{Binding SecondaryCommandLabel}"
                                    Command="{Binding SecondaryCommand}" />
                            <CheckBox Content="Bu oturumda hep izin ver"
                                      IsChecked="{Binding AllowForSession, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      Visibility="{Binding ShowSessionRemember, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding ResolutionNote}"
                                   FontStyle="Italic"
                                   Opacity="0.75"
                                   Visibility="{Binding ResolutionNote, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ResultCardTemplate">
        <Grid Margin="0,6,0,6" HorizontalAlignment="Stretch">
            <Grid HorizontalAlignment="Left" MaxWidth="820">
                <Border Style="{StaticResource ChatAssistantBubbleStyle}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE99A;"
                                      FontFamily="{StaticResource SymbolThemeFontFamily}"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                      VerticalAlignment="Top"
                                      Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Asistan" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{Binding StepInfo}"
                                           Style="{StaticResource ChatMetaTextBlockStyle}"
                                           Visibility="{Binding StepInfo, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                            </StackPanel>
                            <Border Grid.Column="2"
                                    Style="{StaticResource BadgeBorderStyle}"
                                    Background="{Binding StatusBadge, Converter={StaticResource StatusToBrushConverter}}">
                                <TextBlock Text="{Binding StatusBadge}"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="11" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding Body}" Style="{StaticResource ChatBodyTextBlockStyle}" />
                        <Border Style="{StaticResource PlanPanelBorderStyle}"
                                Visibility="{Binding HasPlanPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8FD;"
                                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                                              FontSize="14"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="Kullanılan plan"
                                               Style="{StaticResource LabelTextBlockStyle}"
                                               VerticalAlignment="Center"
                                               Opacity="0.92" />
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                VerticalAlignment="Center">
                                        <Border Style="{StaticResource PlanSkillBadgeBorderStyle}"
                                                Visibility="{Binding HasSkillDomainLabel, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding SkillDomainLabel}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource PlanRevisionBadgeBorderStyle}"
                                                Visibility="{Binding HasPlanRevisionLabel, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding PlanRevisionLabel}"
                                                       FontSize="11"
                                                       Opacity="0.85" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding PlanHeadline}"
                                           FontSize="13"
                                           TextWrapping="WrapWholeWords"
                                           Visibility="{Binding HasPlanHeadline, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <ItemsControl ItemsSource="{Binding PlanSteps}"
                                              ItemTemplate="{StaticResource PlanStepTemplate}"
                                              Visibility="{Binding HasPlanSteps, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>
                        <Grid ColumnSpacing="16"
                              RowSpacing="4"
                              Visibility="{Binding DeveloperModeEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="Gözlem" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding ObservationSummary}"
                                       Style="{StaticResource MetadataValueTextBlockStyle}"
                                       TextWrapping="WrapWholeWords" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="Log" />
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding LogPath}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Opacity="0.85"
                                       TextWrapping="WrapWholeWords"
                                       IsTextSelectionEnabled="True" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding PrimaryCommand}"
                                    Visibility="{Binding PrimaryCommandLabel, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8A5;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" />
                                    <TextBlock Text="{Binding PrimaryCommandLabel}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{Binding TimestampDisplay}" Style="{StaticResource ChatMetaTextBlockStyle}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ErrorCardTemplate">
        <Grid Margin="0,6,0,6" HorizontalAlignment="Stretch">
            <Grid HorizontalAlignment="Left" MaxWidth="820">
                <Border Style="{StaticResource CardBorderStyle}"
                        BorderBrush="{ThemeResource SystemFillColorCriticalBrush}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE783;"
                                      FontFamily="{StaticResource SymbolThemeFontFamily}"
                                      Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Title}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextWrapping="WrapWholeWords"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </Grid>
                        <TextBlock Text="{Binding Body}" Style="{StaticResource ChatBodyTextBlockStyle}" />
                        <Button Command="{Binding PrimaryCommand}"
                                HorizontalAlignment="Left"
                                Visibility="{Binding PrimaryCommandLabel, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE713;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" />
                                <TextBlock Text="{Binding PrimaryCommandLabel}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding TimestampDisplay}" Style="{StaticResource ChatMetaTextBlockStyle}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DataTemplate>

    <templates:ConversationTemplateSelector
        x:Key="ConversationTemplateSelector"
        UserMessageTemplate="{StaticResource UserMessageTemplate}"
        LiveActivityTemplate="{StaticResource LiveActivityTemplate}"
        AssistantStatusTemplate="{StaticResource AssistantStatusTemplate}"
        PendingApprovalTemplate="{StaticResource PendingApprovalTemplate}"
        ResultCardTemplate="{StaticResource ResultCardTemplate}"
        ErrorCardTemplate="{StaticResource ErrorCardTemplate}" />

</ResourceDictionary>
