<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WindowsAiAssistant.App.Converters"
    xmlns:templates="using:WindowsAiAssistant.App.Templates">

    <converters:RiskLevelToBrushConverter x:Key="RiskLevelToBrushConverter" />
    <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />

    <DataTemplate x:Key="UserMessageTemplate">
        <Grid Margin="0,4,0,4" HorizontalAlignment="Right" MaxWidth="640">
            <Border CornerRadius="14,14,2,14"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    Padding="14,10">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Body}"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding TimestampDisplay}"
                               FontSize="11"
                               Opacity="0.85"
                               HorizontalAlignment="Right"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="AssistantStatusTemplate">
        <Grid Margin="0,4,0,4" HorizontalAlignment="Left" MaxWidth="640">
            <Border CornerRadius="14,14,14,2"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    Padding="14,10">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TimestampDisplay}" FontSize="11" Opacity="0.65" />
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="PendingApprovalTemplate">
        <Grid Margin="0,4,0,4" HorizontalAlignment="Stretch" MaxWidth="720">
            <Border Style="{StaticResource CardBorderStyle}"
                    BorderBrush="{ThemeResource SystemFillColorCautionBrush}">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7BA;"
                                  FontFamily="{StaticResource SymbolThemeFontFamily}"
                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Title}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="2"
                                Style="{StaticResource BadgeBorderStyle}"
                                Background="{Binding StatusBadge, Converter={StaticResource StatusToBrushConverter}}">
                            <TextBlock Text="{Binding StatusBadge}"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="11" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="ARAÇ" />
                            <TextBlock Text="{Binding SelectedTool}" FontSize="13" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="20,0,0,0">
                            <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="RİSK" />
                            <Border Style="{StaticResource BadgeBorderStyle}"
                                    Background="{Binding RiskLevel, Converter={StaticResource RiskLevelToBrushConverter}}">
                                <TextBlock Text="{Binding RiskLevel}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding TimestampDisplay}" FontSize="11" Opacity="0.65" />
                    </Grid>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                Visibility="{Binding IsApprovalActionable, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Style="{ThemeResource AccentButtonStyle}"
                                Content="{Binding PrimaryCommandLabel}"
                                Command="{Binding PrimaryCommand}" />
                        <Button Content="{Binding SecondaryCommandLabel}"
                                Command="{Binding SecondaryCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ResolutionNote}"
                               FontStyle="Italic"
                               Opacity="0.75"
                               Visibility="{Binding ResolutionNote, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ResultCardTemplate">
        <Grid Margin="0,4,0,4" HorizontalAlignment="Stretch" MaxWidth="720">
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE73E;"
                                  FontFamily="{StaticResource SymbolThemeFontFamily}"
                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Title}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="2"
                                Style="{StaticResource BadgeBorderStyle}"
                                Background="{Binding StatusBadge, Converter={StaticResource StatusToBrushConverter}}">
                            <TextBlock Text="{Binding StatusBadge}"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="11" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="20" RowSpacing="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="ARAÇ" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedTool}" Style="{StaticResource MetadataValueTextBlockStyle}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="RİSK" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Border Style="{StaticResource BadgeBorderStyle}"
                                    Background="{Binding RiskLevel, Converter={StaticResource RiskLevelToBrushConverter}}">
                                <TextBlock Text="{Binding RiskLevel}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="GÜVENLİK" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SafetyDisposition}" Style="{StaticResource MetadataValueTextBlockStyle}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="KARAR" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Decision}" Style="{StaticResource MetadataValueTextBlockStyle}" />
                    </Grid>
                    <TextBlock Text="{Binding ToolExecutionResult}"
                               FontFamily="Consolas"
                               FontSize="12"
                               Opacity="0.85"
                               TextWrapping="Wrap"
                               Visibility="{Binding ToolExecutionResult, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                    <TextBlock Text="{Binding TimestampDisplay}" FontSize="11" Opacity="0.65" HorizontalAlignment="Right" />
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ErrorCardTemplate">
        <Grid Margin="0,4,0,4" HorizontalAlignment="Stretch" MaxWidth="720">
            <Border Style="{StaticResource CardBorderStyle}"
                    BorderBrush="{ThemeResource SystemFillColorCriticalBrush}">
                <StackPanel Spacing="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE783;"
                                  FontFamily="{StaticResource SymbolThemeFontFamily}"
                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Title}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    </Grid>
                    <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TimestampDisplay}" FontSize="11" Opacity="0.65" HorizontalAlignment="Right" />
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <templates:ConversationTemplateSelector
        x:Key="ConversationTemplateSelector"
        UserMessageTemplate="{StaticResource UserMessageTemplate}"
        AssistantStatusTemplate="{StaticResource AssistantStatusTemplate}"
        PendingApprovalTemplate="{StaticResource PendingApprovalTemplate}"
        ResultCardTemplate="{StaticResource ResultCardTemplate}"
        ErrorCardTemplate="{StaticResource ErrorCardTemplate}" />

</ResourceDictionary>
