<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="AssistantPillBackgroundColor">#F8FFFFFF</Color>
    <Color x:Key="AssistantPillBorderColor">#1A000000</Color>
    <Color x:Key="AssistantShadowColor">#33000000</Color>
    <Color x:Key="AssistantTextPrimaryColor">#FF1A1A1A</Color>
    <Color x:Key="AssistantTextSecondaryColor">#FF5F6368</Color>
    <Color x:Key="AssistantTextMutedColor">#FF80868B</Color>
    <Color x:Key="AssistantUserBubbleColor">#FFF1F3F4</Color>
    <Color x:Key="AssistantAccentBarColor">#FF4285F4</Color>

    <Color x:Key="AssistantDotBlueColor">#FF4285F4</Color>
    <Color x:Key="AssistantDotRedColor">#FFEA4335</Color>
    <Color x:Key="AssistantDotYellowColor">#FFFBBC04</Color>
    <Color x:Key="AssistantDotGreenColor">#FF34A853</Color>

    <SolidColorBrush x:Key="AssistantPillBackgroundBrush" Color="{StaticResource AssistantPillBackgroundColor}" />
    <SolidColorBrush x:Key="AssistantPillBorderBrush" Color="{StaticResource AssistantPillBorderColor}" />
    <SolidColorBrush x:Key="AssistantShadowBrush" Color="{StaticResource AssistantShadowColor}" />
    <SolidColorBrush x:Key="AssistantTextPrimaryBrush" Color="{StaticResource AssistantTextPrimaryColor}" />
    <SolidColorBrush x:Key="AssistantTextSecondaryBrush" Color="{StaticResource AssistantTextSecondaryColor}" />
    <SolidColorBrush x:Key="AssistantTextMutedBrush" Color="{StaticResource AssistantTextMutedColor}" />
    <SolidColorBrush x:Key="AssistantUserBubbleBrush" Color="{StaticResource AssistantUserBubbleColor}" />
    <SolidColorBrush x:Key="AssistantAccentBarBrush" Color="{StaticResource AssistantAccentBarColor}" />

    <SolidColorBrush x:Key="AssistantDotBlueBrush" Color="{StaticResource AssistantDotBlueColor}" />
    <SolidColorBrush x:Key="AssistantDotRedBrush" Color="{StaticResource AssistantDotRedColor}" />
    <SolidColorBrush x:Key="AssistantDotYellowBrush" Color="{StaticResource AssistantDotYellowColor}" />
    <SolidColorBrush x:Key="AssistantDotGreenBrush" Color="{StaticResource AssistantDotGreenColor}" />

    <CornerRadius x:Key="AssistantPillCornerRadius">28</CornerRadius>
    <CornerRadius x:Key="AssistantBubbleCornerRadius">14</CornerRadius>
    <x:Double x:Key="AssistantPillMinHeight">54</x:Double>

    <Style x:Key="AssistantStatusTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource AssistantTextPrimaryBrush}" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style x:Key="AssistantSubtextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource AssistantTextSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="LineHeight" Value="18" />
    </Style>

    <Style x:Key="AssistantCloseButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#0F000000" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="7" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="MinHeight" Value="34" />
    </Style>

</ResourceDictionary>
