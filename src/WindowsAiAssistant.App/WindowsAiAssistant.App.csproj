<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.260224002" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="Vosk" Version="0.3.38" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WindowsAiAssistant.Agent\WindowsAiAssistant.Agent.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize>true</WindowsAppSdkUndockedRegFreeWinRTInitialize>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Version>1.0.3</Version>
    <AssemblyVersion>1.0.3.0</AssemblyVersion>
    <FileVersion>1.0.3.0</FileVersion>
    <AssemblyTitle>Windows AI Assistant</AssemblyTitle>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Square44x44Logo.scale-200.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Square150x150Logo.scale-200.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\StoreLogo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\SplashScreen.scale-200.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Wide310x150Logo.scale-200.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.Local.json.example">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Calisan uygulamayi build oncesi sonlandirir; cikti DLL kilidinden kaynaklanan
       MSB3021/MSB3027 hatalarini kalici olarak onler. Surec yoksa cikti/exit-kodu
       yok sayilir (idempotent). -->
  <Target Name="StopRunningAppBeforeBuild" BeforeTargets="BeforeBuild" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="taskkill /F /IM WindowsAiAssistant.App.exe /T &gt;nul 2&gt;&amp;1 &amp; exit /b 0" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" />
  </Target>

  <Target Name="EnsureWhisperMediumModel" BeforeTargets="PrepareForBuild" Condition="'$(OS)' == 'Windows_NT' and '$(SkipWhisperModelOnPublish)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\scripts\ensure-whisper-medium.ps1&quot; -ProjectDir &quot;$(MSBuildProjectDirectory)&quot;"
          StandardOutputImportance="high" />
  </Target>

  <Target Name="IncludeWhisperModelOutput" AfterTargets="EnsureWhisperMediumModel" BeforeTargets="AssignTargetPaths" Condition="'$(OS)' == 'Windows_NT'">
    <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\Assets\Models\whisper\ggml-medium.bin')">
      <Content Include="$(MSBuildProjectDirectory)\Assets\Models\whisper\ggml-medium.bin">
        <Link>models\whisper\ggml-medium.bin</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
  </Target>

  <!-- dotnet publish, WinUI .pri/.xbf dosyalarini varsayilan olarak almaz; unpackaged kurulumda XAML yuklenemez. -->
  <Target Name="IncludeWinUIResourceFilesInPublish"
          AfterTargets="ComputeFilesToPublish"
          Condition="'$(RuntimeIdentifier)' != ''">
    <PropertyGroup>
      <_WinUIResourceDir>$(MSBuildProjectDirectory)\$(BaseOutputPath)$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\</_WinUIResourceDir>
    </PropertyGroup>
    <ItemGroup>
      <WinUIResourceToPublish Include="$(_WinUIResourceDir)App.xbf" Condition="Exists('$(_WinUIResourceDir)App.xbf')" />
      <WinUIResourceToPublish Include="$(_WinUIResourceDir)MainWindow.xbf" Condition="Exists('$(_WinUIResourceDir)MainWindow.xbf')" />
      <WinUIResourceToPublish Include="$(_WinUIResourceDir)$(AssemblyName).pri" Condition="Exists('$(_WinUIResourceDir)$(AssemblyName).pri')" />
    </ItemGroup>
    <ItemGroup>
      <ResolvedFileToPublish Include="@(WinUIResourceToPublish)">
        <RelativePath>%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
