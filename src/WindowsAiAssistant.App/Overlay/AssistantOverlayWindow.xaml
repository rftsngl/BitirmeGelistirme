<Window
    x:Class="WindowsAiAssistant.App.Overlay.AssistantOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid x:Name="WindowRoot" Background="Transparent">
        <!-- Yumusak golge (siyah kose artefakti yerine seffaf zemin) -->
        <Border x:Name="PillShadow"
                Background="{StaticResource AssistantShadowBrush}"
                CornerRadius="30"
                Margin="0,6,0,0"
                Opacity="0.22"
                IsHitTestVisible="False" />

        <Border x:Name="CardBorder"
                Background="{StaticResource AssistantPillBackgroundBrush}"
                BorderBrush="{StaticResource AssistantPillBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource AssistantPillCornerRadius}"
                Padding="14,10"
                MinWidth="440"
                MaxWidth="580"
                KeyDown="Root_KeyDown">
            <Grid x:Name="Root">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="ListenBar"
                      Grid.Row="0"
                      MinHeight="{StaticResource AssistantPillMinHeight}"
                      VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="AssistantOrb"
                          Width="40"
                          Height="40"
                          VerticalAlignment="Center">
                        <Ellipse x:Name="SpeakingRing"
                                 Width="40"
                                 Height="40"
                                 Stroke="#664285F4"
                                 StrokeThickness="2.5"
                                 Opacity="0"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="SpeakingRingScale" ScaleX="1" ScaleY="1" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Border Width="34"
                                Height="34"
                                CornerRadius="17"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#0A000000" />
                        <Grid Width="22"
                              Height="22"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10"
                                     Fill="{StaticResource AssistantDotBlueBrush}"
                                     HorizontalAlignment="Left" VerticalAlignment="Top" />
                            <Ellipse Width="10" Height="10"
                                     Fill="{StaticResource AssistantDotRedBrush}"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" />
                            <Ellipse Width="10" Height="10"
                                     Fill="{StaticResource AssistantDotYellowBrush}"
                                     HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                            <Ellipse Width="10" Height="10"
                                     Fill="{StaticResource AssistantDotGreenBrush}"
                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Column="1"
                                Margin="14,0,12,0"
                                VerticalAlignment="Center"
                                Spacing="1">
                        <TextBlock Text="{Binding StatusText}"
                                   Style="{StaticResource AssistantStatusTextStyle}" />
                        <TextBlock Text="{Binding LiveTranscript}"
                                   Style="{StaticResource AssistantSubtextStyle}"
                                   Visibility="{Binding HasLiveTranscript, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Text="{Binding SubstatusText}"
                                   Style="{StaticResource AssistantSubtextStyle}"
                                   Visibility="{Binding ShowPillSubstatus, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>

                    <StackPanel x:Name="ListeningDotsPanel"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="6"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding ShowListeningDots, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Ellipse x:Name="ListenDot0" Width="9" Height="9" Fill="{StaticResource AssistantDotBlueBrush}" />
                        <Ellipse x:Name="ListenDot1" Width="9" Height="9" Fill="{StaticResource AssistantDotRedBrush}" />
                        <Ellipse x:Name="ListenDot2" Width="9" Height="9" Fill="{StaticResource AssistantDotYellowBrush}" />
                        <Ellipse x:Name="ListenDot3" Width="9" Height="9" Fill="{StaticResource AssistantDotGreenBrush}" />
                    </StackPanel>

                    <StackPanel x:Name="ThinkingDotsPanel"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="6"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding ShowThinkingDots, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Ellipse x:Name="ThinkDot0" Width="8" Height="8" Fill="{StaticResource AssistantDotBlueBrush}" Opacity="0.35" />
                        <Ellipse x:Name="ThinkDot1" Width="8" Height="8" Fill="{StaticResource AssistantDotRedBrush}" Opacity="0.55" />
                        <Ellipse x:Name="ThinkDot2" Width="8" Height="8" Fill="{StaticResource AssistantDotGreenBrush}" Opacity="0.75" />
                    </StackPanel>

                    <Button Grid.Column="3"
                            Style="{StaticResource AssistantCloseButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTipService.ToolTip="Kapat (ESC)">
                        <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{StaticResource AssistantTextSecondaryBrush}" />
                    </Button>
                </Grid>

                <StackPanel x:Name="ExpandedPanel"
                            Grid.Row="1"
                            Spacing="10"
                            Margin="2,12,2,0"
                            Visibility="{Binding ShowExpandedPanel, Converter={StaticResource BoolToVisibilityConverter}}">

                    <Border Background="{StaticResource AssistantUserBubbleBrush}"
                            CornerRadius="{StaticResource AssistantBubbleCornerRadius}"
                            Padding="12,8"
                            Visibility="{Binding TranscriptText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Siz"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AssistantTextMutedBrush}" />
                            <TextBlock Text="{Binding TranscriptText}"
                                       FontSize="13"
                                       Foreground="{StaticResource AssistantTextPrimaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Grid Visibility="{Binding ResultText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{StaticResource AssistantAccentBarBrush}"
                                CornerRadius="2"
                                Margin="0,2,0,2" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2">
                            <TextBlock Text="Asistan"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AssistantTextMutedBrush}" />
                            <TextBlock Text="{Binding ResultText}"
                                       FontSize="14"
                                       Foreground="{StaticResource AssistantTextPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="22" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding DetailText}"
                               FontSize="13"
                               Foreground="{StaticResource AssistantTextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Visibility="{Binding DetailText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />

                    <TextBlock Text="{Binding DeveloperDetailText}"
                               FontSize="11"
                               FontFamily="Consolas"
                               Foreground="{StaticResource AssistantTextMutedBrush}"
                               TextWrapping="Wrap"
                               Visibility="{Binding ShowDeveloperDetail, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <muxc:ProgressRing IsActive="{Binding IsBusy}"
                                       Width="20"
                                       Height="20"
                                       Foreground="{StaticResource AssistantDotBlueBrush}"
                                       HorizontalAlignment="Left"
                                       Visibility="{Binding ShowProgressRing, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <StackPanel Spacing="8"
                                Visibility="{Binding ShowManualInput, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBox x:Name="ManualInputBox"
                                 PlaceholderText="Komutunuzu yazın…"
                                 Text="{Binding ManualInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Gönder"
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="ManualSubmitButton_Click"
                                HorizontalAlignment="Right" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Right"
                                Visibility="{Binding IsAwaitingApproval, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Content="Onayla"
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="ApproveButton_Click" />
                        <Button Content="Reddet"
                                Click="DenyButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
