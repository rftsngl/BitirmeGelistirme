<Page
    x:Class="WindowsAiAssistant.App.Views.AssistantPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="Asistan" Style="{StaticResource PageTitleTextBlockStyle}" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource PageSubtitleTextBlockStyle}" />

            <Border Style="{StaticResource CardBorderStyle}"
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE7B5;"
                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                              FontSize="18"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0" />

                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock>
                            <Run Text="Aktif sağlayıcı: " Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Run Text="{Binding ProviderStatus.DisplayName, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding ProviderStatus.Kind, Mode=OneWay}" FontSize="11" Opacity="0.7" />
                            <TextBlock Text="·" FontSize="11" Opacity="0.45" />
                            <TextBlock Text="{Binding ProviderStatus.Model, Mode=OneWay}" FontSize="11" Opacity="0.85" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="2"
                            Style="{StaticResource BadgeBorderStyle}"
                            Margin="8,0,8,0"
                            Background="{Binding ProviderStatus.ReadyBadge, Mode=OneWay, Converter={StaticResource StatusToBrushConverter}}">
                        <TextBlock Text="{Binding ProviderStatus.ReadyBadge, Mode=OneWay}"
                                   Foreground="White"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                    </Border>

                    <Button Grid.Column="3"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTipService.ToolTip="Sağlayıcı ayarlarına git">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE713;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" />
                            <TextBlock Text="Sağlayıcıyı Değiştir" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource CardBorderStyle}"
                Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="ConversationScrollViewer"
                              Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled"
                              VerticalScrollMode="Enabled">
                    <Grid>
                        <StackPanel Spacing="12"
                                    Visibility="{Binding HasConversation, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                            <FontIcon Glyph="&#xE99A;"
                                      FontFamily="{StaticResource SymbolThemeFontFamily}"
                                      FontSize="40"
                                      Opacity="0.45"
                                      HorizontalAlignment="Center" />
                            <TextBlock Text="Henüz bir komut göndermediniz"
                                       HorizontalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Opacity="0.75" />
                            <TextBlock Text="Aşağıdaki kutuya komutunuzu yazın. Yanıtlar, onaylar ve sonuçlar burada zaman akışı olarak görünecek."
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="420"
                                       TextAlignment="Center"
                                       Opacity="0.6" />
                        </StackPanel>

                        <ItemsControl x:Name="ConversationList"
                                      ItemsSource="{Binding Conversation}"
                                      ItemTemplateSelector="{StaticResource ConversationTemplateSelector}"
                                      Visibility="{Binding HasConversation, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}"
                Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox x:Name="CommandInputTextBox"
                         Grid.Row="0" Grid.Column="0"
                         PlaceholderText="Komutunuzu yazın (Ctrl+Enter ile gönder)"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="60"
                         MaxHeight="160"
                         Text="{Binding CommandInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="CommandInputTextBox_KeyDown"
                         IsEnabled="{Binding IsNotBusy}" />

                <StackPanel Grid.Row="0" Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            Spacing="6"
                            Margin="10,0,0,0">
                    <muxc:ProgressRing Width="22"
                                       Height="22"
                                       IsActive="{Binding IsBusy}"
                                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button x:Name="SubmitButton"
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{Binding SubmitCommand}"
                            ToolTipService.ToolTip="Komutu gönder (Ctrl+Enter)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE724;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14" />
                            <TextBlock Text="Gönder" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            Margin="0,8,0,0">
                    <Button Command="{Binding ClearSessionCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" />
                            <TextBlock Text="Oturumu Temizle" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenSettingsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE713;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" />
                            <TextBlock Text="Sağlayıcı Ayarları" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
