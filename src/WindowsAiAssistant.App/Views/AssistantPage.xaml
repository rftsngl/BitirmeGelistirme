<Page
    x:Class="WindowsAiAssistant.App.Views.AssistantPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Asistan" Style="{StaticResource PageTitleTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Style="{StaticResource StatusDotStyle}"
                             Fill="{Binding ProviderStatus.ReadyBadge, Mode=OneWay, Converter={StaticResource StatusToBrushConverter}}" />
                    <TextBlock Text="{Binding UserFriendlyStatus}" FontSize="13" Opacity="0.85" TextWrapping="WrapWholeWords" />
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1"
                    Style="{StaticResource GhostButtonStyle}"
                    Command="{Binding OpenSettingsCommand}"
                    VerticalAlignment="Top"
                    ToolTipService.ToolTip="Model ve bağlantı ayarları">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE713;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" />
                    <TextBlock Text="Ayarlar" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource CardBorderStyle}"
                Padding="12,10"
                HorizontalAlignment="Stretch">
            <ScrollViewer x:Name="ConversationScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalAlignment="Stretch">
                <Grid MinHeight="320" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="24"
                                MaxWidth="520"
                                Visibility="{Binding HasConversation, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                        <FontIcon Glyph="&#xE799;"
                                  FontFamily="{StaticResource SymbolThemeFontFamily}"
                                  FontSize="48"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="Nasıl yardımcı olabilirim?"
                                   HorizontalAlignment="Center"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                        <TextBlock Text="Bilgisayarınızdaki işleri doğal dille tarif edin. Asistan ne yapacağını kendisi planlar; siz süreci burada anlık izlersiniz."
                                   Style="{StaticResource SettingDescriptionTextBlockStyle}"
                                   TextAlignment="Center"
                                   TextWrapping="WrapWholeWords" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Button Style="{StaticResource ChipButtonStyle}" Tag="Ekranda ne var?" Click="Chip_Click">
                                <TextBlock Text="Ekranda ne var?" />
                            </Button>
                            <Button Style="{StaticResource ChipButtonStyle}" Tag="Not defterini aç" Click="Chip_Click">
                                <TextBlock Text="Not defterini aç" />
                            </Button>
                            <Button Style="{StaticResource ChipButtonStyle}" Tag="Açık pencereleri özetle" Click="Chip_Click">
                                <TextBlock Text="Açık pencereleri özetle" />
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <ItemsControl x:Name="ConversationList"
                                  ItemsSource="{Binding Conversation}"
                                  ItemTemplateSelector="{StaticResource ConversationTemplateSelector}"
                                  HorizontalAlignment="Stretch"
                                  Visibility="{Binding HasConversation, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" HorizontalAlignment="Stretch" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Spacing="8">
            <Border Style="{StaticResource ChatComposerShellStyle}">
                <Grid ColumnSpacing="4" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox x:Name="CommandInputTextBox"
                             Grid.Row="0"
                             Grid.Column="0"
                             Grid.ColumnSpan="2"
                             Style="{StaticResource ChatComposerTextBoxStyle}"
                             PlaceholderText="Bir şey yazın…"
                             MinHeight="48"
                             MaxHeight="180"
                             Text="{Binding CommandInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="CommandInputTextBox_PreviewKeyDown"
                             IsEnabled="{Binding IsNotBusy}" />

                    <StackPanel Grid.Row="1"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                Margin="0,0,4,4"
                                HorizontalAlignment="Right">
                        <muxc:ProgressRing Width="20"
                                           Height="20"
                                           IsActive="{Binding IsBusy}"
                                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Button Style="{StaticResource ChatComposerIconButtonStyle}"
                                IsEnabled="{Binding IsNotBusy}"
                                Click="VoiceButton_Click"
                                ToolTipService.ToolTip="Sesli komut">
                            <FontIcon Glyph="&#xE720;"
                                      FontFamily="{StaticResource SymbolThemeFontFamily}"
                                      FontSize="15" />
                        </Button>
                        <Button x:Name="SubmitButton"
                                Style="{StaticResource ChatComposerSendButtonStyle}"
                                Command="{Binding SubmitCommand}"
                                ToolTipService.ToolTip="Gönder (Enter)">
                            <FontIcon Glyph="&#xE724;"
                                      FontFamily="{StaticResource SymbolThemeFontFamily}"
                                      FontSize="15" />
                        </Button>
                        <Button Style="{StaticResource ChatComposerIconButtonStyle}"
                                Command="{Binding CancelRunCommand}"
                                IsEnabled="{Binding IsBusy}"
                                ToolTipService.ToolTip="Durdur (Esc)">
                            <FontIcon Glyph="&#xE711;"
                                      FontFamily="{StaticResource SymbolThemeFontFamily}"
                                      FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding ClearSessionCommand}"
                        Padding="4,2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE894;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="12" />
                        <TextBlock Text="Temizle" FontSize="12" />
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="1"
                           Text="Enter gönder · Shift+Enter yeni satır · Esc durdur"
                           Style="{StaticResource ChatMetaTextBlockStyle}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           TextAlignment="Right" />
            </Grid>
        </StackPanel>
    </Grid>
</Page>
