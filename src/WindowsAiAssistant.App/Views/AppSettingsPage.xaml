<Page
    x:Class="WindowsAiAssistant.App.Views.AppSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <ScrollViewer Padding="{StaticResource PagePadding}" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" MaxWidth="720">
            <TextBlock Text="Ses ve Güvenlik" Style="{StaticResource PageTitleTextBlockStyle}" />
            <TextBlock Text="Sesli popup, wake-word, ActionGate ve başlangıç ayarları. Kayıt appsettings.Local.json dosyasına yazılır."
                       Style="{StaticResource PageSubtitleTextBlockStyle}" />

            <muxc:InfoBar Title="Durum"
                          IsClosable="False"
                          Severity="Informational"
                          Message="{Binding StatusMessage, Mode=OneWay}"
                          IsOpen="True"
                          Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />

            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Sesli asistan (Faz 11)" FontWeight="SemiBold" />
                    <ToggleSwitch Header="Arka plan / tray modu" IsOn="{Binding BackgroundModeEnabled, Mode=TwoWay}" />
                    <ToggleSwitch Header="Başlangıçta tray'e küçült" IsOn="{Binding StartMinimizedToTray, Mode=TwoWay}" />
                    <ToggleSwitch Header="Windows ile birlikte başlat" IsOn="{Binding StartWithWindows, Mode=TwoWay}" />
                    <ToggleSwitch Header="Global hotkey (Ctrl+Alt+A)" IsOn="{Binding GlobalHotKeyEnabled, Mode=TwoWay}" />
                    <TextBox Header="Hotkey ifadesi" Text="{Binding GlobalHotKey, Mode=TwoWay}" />
                    <ToggleSwitch Header="Metin okuma (TTS)" IsOn="{Binding TextToSpeechEnabled, Mode=TwoWay}" />
                    <TextBox Header="Konuşma dili (BCP-47)" Text="{Binding SpeechLanguage, Mode=TwoWay}" />
                    <NumberBox Header="Dinleme zaman aşımı (sn)" Value="{Binding SpeechListenTimeoutSeconds, Mode=TwoWay}" Minimum="3" Maximum="120" SpinButtonPlacementMode="Inline" />
                    <NumberBox Header="Overlay otomatik kapanma (sn)" Value="{Binding OverlayAutoCloseSeconds, Mode=TwoWay}" Minimum="3" Maximum="120" SpinButtonPlacementMode="Inline" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Konuşma tanıma (STT) ve mikrofon" FontWeight="SemiBold" />
                    <ComboBox Header="STT motoru"
                              ItemsSource="{Binding SpeechEngineOptions}"
                              SelectedItem="{Binding SpeechEngine, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" />
                    <TextBlock Text="windows = yerleşik Windows STT · whisper = yerel Whisper.net (ggml model dosyası gerekir)"
                               Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                    <TextBox Header="Whisper model (.bin/ggml) yolu"
                             Text="{Binding WhisperModelPath, Mode=TwoWay}"
                             Visibility="{Binding IsWhisperEngine, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <ComboBox Header="Mikrofon cihazı"
                              ItemsSource="{Binding MicrophoneOptions}"
                              SelectedItem="{Binding SelectedMicrophone, Mode=TwoWay}"
                              DisplayMemberPath="Display"
                              HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Uyandırma kelimesi (Vosk)" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding WakeWordServiceSummary}" Opacity="0.75" TextWrapping="Wrap" />
                    <ToggleSwitch Header="Uyandırma kelimesi etkin" IsOn="{Binding WakeWordEnabled, Mode=TwoWay}" IsEnabled="{Binding IsWakeWordServiceAvailable}" />
                    <ComboBox Header="Kelime" ItemsSource="{x:Bind ViewModel.WakeWordChoices, Mode=OneWay}"
                              SelectedItem="{Binding SelectedWakeWord, Mode=TwoWay}"
                              DisplayMemberPath="Display" HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="UI otomasyon (Faz 10)" FontWeight="SemiBold" />
                    <TextBlock Text="Degisikliklerin etkinlesmesi icin uygulamayi yeniden baslatin."
                               Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                    <ToggleSwitch Header="Chromium/Electron erisilebilirlik uyandirma (WM_GETOBJECT)"
                                  IsOn="{Binding EnableChromiumAccessibility, Mode=TwoWay}" />
                    <ToggleSwitch Header="UIA2 fallback (eski WinForms/Win32)"
                                  IsOn="{Binding EnableUia2Fallback, Mode=TwoWay}" />
                    <NumberBox Header="UIA2 fallback esik (UIA3 element sayisi)"
                               Value="{Binding Uia2FallbackMinElements, Mode=TwoWay}"
                               Minimum="1"
                               Maximum="20"
                               SpinButtonPlacementMode="Inline" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="ActionGate (Faz 12)" FontWeight="SemiBold" />
                    <ComboBox Header="Normal risk" ItemsSource="{Binding RiskHandlingOptions}" SelectedItem="{Binding NormalHandling, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                    <ComboBox Header="Hassas işlemler" ItemsSource="{Binding RiskHandlingOptions}" SelectedItem="{Binding SensitiveHandling, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                    <ComboBox Header="Yıkıcı işlemler" ItemsSource="{Binding RiskHandlingOptions}" SelectedItem="{Binding DestructiveHandling, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                    <ToggleSwitch Header="Oturum boyunca 'hep izin ver' seçeneğini göster" IsOn="{Binding AllowSessionRemember, Mode=TwoWay}" />
                    <ToggleSwitch Header="Sesli onay (sohbet + overlay'de 'onayla/reddet' söyleme)" IsOn="{Binding VoiceApprovalEnabled, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Button Style="{ThemeResource AccentButtonStyle}" Click="Save_OnClick" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74E;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14" />
                    <TextBlock Text="Kaydet" />
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</Page>
