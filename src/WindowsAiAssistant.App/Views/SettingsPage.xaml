<Page
    x:Class="WindowsAiAssistant.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:ps="using:WindowsAiAssistant.App.ProviderSettings">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Text="Sağlayıcı Ayarları" Style="{StaticResource PageTitleTextBlockStyle}" />
                <Border Style="{StaticResource CardBorderStyle}"
                        Padding="10,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE7B5;"
                                  FontFamily="{StaticResource SymbolThemeFontFamily}"
                                  FontSize="16"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0" />
                        <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                            <TextBlock>
                                <Run Text="Aktif: " Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Run Text="{Binding ProviderStatus.DisplayName, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding ProviderStatus.Kind, Mode=OneWay}" FontSize="11" Opacity="0.7" />
                                <TextBlock Text="·" FontSize="11" Opacity="0.45" />
                                <TextBlock Text="{Binding ProviderStatus.Model, Mode=OneWay}" FontSize="11" Opacity="0.85" />
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="2"
                                Style="{StaticResource BadgeBorderStyle}"
                                Background="{Binding ProviderStatus.ReadyBadge, Mode=OneWay, Converter={StaticResource StatusToBrushConverter}}">
                            <TextBlock Text="{Binding ProviderStatus.ReadyBadge, Mode=OneWay}"
                                       Foreground="White"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Style="{ThemeResource AccentButtonStyle}" Click="NewProfile_OnClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" />
                        <TextBlock Text="Yeni Profil" />
                    </StackPanel>
                </Button>
                <Button Click="PresetOpenAi_OnClick" ToolTipService.ToolTip="OpenAI (GPT-4.1-mini) profili hazırla">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="OpenAI" />
                    </StackPanel>
                </Button>
                <Button Click="PresetGemini_OnClick" ToolTipService.ToolTip="Google Gemini profili hazırla">
                    <TextBlock Text="Gemini" />
                </Button>
                <Button Click="PresetOllama_OnClick" ToolTipService.ToolTip="Ollama (yerel) profili hazırla">
                    <TextBlock Text="Ollama" />
                </Button>
                <Button Click="PresetLmStudio_OnClick" ToolTipService.ToolTip="LM Studio (yerel) profili hazırla">
                    <TextBlock Text="LM Studio" />
                </Button>
                <Button Click="EditProfile_OnClick" IsEnabled="{Binding EditEnabled}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE70F;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" />
                        <TextBlock Text="Düzenle" />
                    </StackPanel>
                </Button>
                <Button Click="DeleteProfile_OnClick" IsEnabled="{Binding DeleteEnabled}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" />
                        <TextBlock Text="Sil" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <muxc:InfoBar Grid.Row="1"
                      Title="Durum"
                      IsClosable="False"
                      Severity="Informational"
                      Message="{Binding StatusMessage, Mode=OneWay}"
                      IsOpen="True"
                      Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />

        <Grid Grid.Row="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="240" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="6">
                <ListView x:Name="ProfilesListBox"
                          ItemsSource="{Binding ProfileItems}"
                          SelectionChanged="ProfilesListBox_OnSelectionChanged"
                          SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="10,8" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="ps:ProfileListItem">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{x:Bind DisplayName}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />

                                <Border Grid.Row="0" Grid.Column="1"
                                        Style="{StaticResource BadgeBorderStyle}"
                                        Margin="6,0,0,0"
                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                        Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{x:Bind ActiveBadge, Mode=OneWay}"
                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                </Border>

                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            Margin="0,2,0,0">
                                    <TextBlock Text="{x:Bind Kind}" FontSize="11" Opacity="0.65" />
                                    <TextBlock Text="·" FontSize="11" Opacity="0.45" />
                                    <TextBlock Text="{x:Bind Model}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                    <Border Style="{StaticResource BadgeBorderStyle}"
                                            Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                            Padding="6,1,6,2"
                                            Visibility="{x:Bind ShowKeyBadge, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{x:Bind KeyBadgeText, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <muxc:InfoBar Title="Profil devre dışı"
                                      Severity="Warning"
                                      IsClosable="False"
                                      IsOpen="{Binding ShowDisabledBanner, Mode=OneWay}"
                                      Message="{Binding DisabledBannerText, Mode=OneWay}" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Style="{StaticResource BadgeBorderStyle}"
                                    Background="{ThemeResource AccentFillColorTertiaryBrush}">
                                <TextBlock Text="{Binding DetailOriginLabel, Mode=OneWay}"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <Grid ColumnSpacing="20" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="GÖRÜNEN AD" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DetailDisplayName, Mode=OneWay}" Style="{StaticResource MetadataValueTextBlockStyle}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="TÜR" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DetailKind, Mode=OneWay}" Style="{StaticResource MetadataValueTextBlockStyle}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="BASE URL" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DetailBaseUrl, Mode=OneWay}" Style="{StaticResource MetadataValueTextBlockStyle}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="MODEL" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DetailModel, Mode=OneWay}" Style="{StaticResource MetadataValueTextBlockStyle}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="ENDPOINT" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DetailEndpointPath, Mode=OneWay}" Style="{StaticResource MetadataValueTextBlockStyle}" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="SICAKLIK" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DetailTemperature, Mode=OneWay}" Style="{StaticResource MetadataValueTextBlockStyle}" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="MAX TOKEN" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding DetailMaxTokens, Mode=OneWay}" Style="{StaticResource MetadataValueTextBlockStyle}" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="VISION" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding DetailVisionEnabled, Mode=OneWay}" Style="{StaticResource MetadataValueTextBlockStyle}" />

                            <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="API KEY GEREKLİ" />
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding DetailRequiresApiKey, Mode=OneWay}" Style="{StaticResource MetadataValueTextBlockStyle}" />

                            <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="ETKİN" />
                            <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding DetailIsEnabled, Mode=OneWay}" Style="{StaticResource MetadataValueTextBlockStyle}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{ThemeResource AccentButtonStyle}"
                                    Click="SetActive_OnClick"
                                    IsEnabled="{Binding SetActiveEnabled}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE73E;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" />
                                    <TextBlock Text="{Binding SetActiveButtonText, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <Button Click="TestConnection_OnClick"
                                    IsEnabled="{Binding TestConnectionEnabled}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE968;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" />
                                    <TextBlock Text="Bağlantıyı Test Et" />
                                </StackPanel>
                            </Button>
                            <muxc:ProgressRing Width="20"
                                               Height="20"
                                               VerticalAlignment="Center"
                                               IsActive="{Binding IsTestingConnection, Mode=OneWay}"
                                               Visibility="{Binding IsTestingConnection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <Border Style="{StaticResource CardBorderStyle}"
                                Padding="12,10"
                                Visibility="{Binding HasLastConnectionTest, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding LastConnectionTest.Title, Mode=OneWay}"
                                               FontWeight="SemiBold" />
                                    <Border Grid.Column="1"
                                            Style="{StaticResource BadgeBorderStyle}"
                                            Background="{Binding LastConnectionTest.Title, Mode=OneWay, Converter={StaticResource StatusToBrushConverter}}">
                                        <TextBlock Text="{Binding LastConnectionTest.DurationDisplay, Mode=OneWay}"
                                                   Foreground="White"
                                                   FontSize="11"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding LastConnectionTest.Message, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           Opacity="0.85" />
                                <TextBlock FontSize="11" Opacity="0.65">
                                    <Run Text="Test edildi: " />
                                    <Run Text="{Binding LastConnectionTest.CompletedDisplay, Mode=OneWay}" />
                                </TextBlock>
                                <Button Content="Asistan'da dene"
                                        Click="TryInAssistant_OnClick"
                                        IsEnabled="{Binding CanTryInAssistant, Mode=OneWay}"
                                        HorizontalAlignment="Left"
                                        Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <muxc:Expander Header="API Anahtarı"
                                       IsExpanded="True"
                                       HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Stretch"
                                       Visibility="{Binding KeyAreaVisibility}">
                            <StackPanel Spacing="10" Padding="0,4">
                                <Border Style="{StaticResource CardBorderStyle}"
                                        Padding="12,8"
                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                        Visibility="{Binding HasSavedKeyForCurrent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE73E;"
                                                  FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                  FontSize="16"
                                                  VerticalAlignment="Center" />
                                        <StackPanel Spacing="0">
                                            <TextBlock Text="Kayıtlı anahtar mevcut"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SavedKeyMask, Mode=OneWay}"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       Opacity="0.85" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorderStyle}"
                                        Padding="12,8"
                                        Visibility="{Binding HasSavedKeyForCurrent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE7BA;"
                                                  FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                  FontSize="16"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Text="Henüz API anahtarı kaydedilmedi."
                                                   VerticalAlignment="Center"
                                                   Opacity="0.85" />
                                    </StackPanel>
                                </Border>

                                <PasswordBox x:Name="ApiKeyPasswordBox"
                                             PasswordChanged="ApiKeyPasswordBox_OnPasswordChanged"
                                             PlaceholderText="API anahtarınızı yapıştırın"
                                             Header="API Key" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Style="{ThemeResource AccentButtonStyle}"
                                            Click="SaveKey_OnClick"
                                            IsEnabled="{Binding KeySaveRemoveEnabled}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE74E;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" />
                                            <TextBlock Text="Kaydet" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="RemoveKey_OnClick"
                                            IsEnabled="{Binding HasSavedKeyForCurrent, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE74D;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" />
                                            <TextBlock Text="Kaldır" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </muxc:Expander>

                        <muxc:InfoBar Title="API anahtarı gerekmiyor"
                                      Severity="Informational"
                                      IsClosable="False"
                                      IsOpen="{Binding ShowNoKeyMessage, Mode=OneWay}"
                                      Message="Bu profil yerel veya gömülü çalıştığı için API anahtarına ihtiyaç duymuyor." />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <muxc:ContentDialog x:Name="ProfileEditorDialog"
                            Title="{Binding EditingTitle}"
                            PrimaryButtonText="Kaydet"
                            SecondaryButtonText="İptal"
                            DefaultButton="Primary"
                            PrimaryButtonClick="ProfileEditorDialog_OnPrimaryButtonClick"
                            SecondaryButtonClick="ProfileEditorDialog_OnSecondaryButtonClick">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                <StackPanel Spacing="10" Width="460" DataContext="{Binding EditingDraft}">
                    <muxc:InfoBar x:Name="ProfileEditorErrorBar"
                                  Title="Doğrulama"
                                  Severity="Error"
                                  IsClosable="False"
                                  IsOpen="False" />

                    <TextBox Header="Kimlik (Id)"
                             Text="{Binding Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="ör. my-openai" />
                    <TextBox Header="Görünen Ad"
                             Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="ör. OpenAI (kişisel)" />

                    <ComboBox Header="Sağlayıcı türü"
                              SelectedItem="{Binding Kind, Mode=TwoWay}"
                              ItemsSource="{x:Bind ProviderKinds}" />

                    <TextBox Header="Base URL"
                             Text="{Binding BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="https://api.openai.com/v1" />
                    <TextBox Header="Model"
                             Text="{Binding Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="gpt-4.1-mini" />

                    <ComboBox Header="Endpoint stili"
                              SelectedItem="{Binding EndpointStyle, Mode=TwoWay}"
                              ItemsSource="{x:Bind EndpointStyles}" />

                    <TextBox Header="Endpoint yolu"
                             Text="{Binding EndpointPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="chat/completions" />

                    <TextBox Header="Temperature (opsiyonel)"
                             Text="{Binding TemperatureText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="0.7" />
                    <TextBox Header="Max tokens (opsiyonel)"
                             Text="{Binding MaxTokensText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="4096" />
                    <NumberBox Header="Istek zaman asimi (sn)"
                               Value="{Binding RequestTimeoutSeconds, Mode=TwoWay}"
                               Minimum="5"
                               Maximum="600"
                               SpinButtonPlacementMode="Inline" />

                    <ToggleSwitch Header="Vision destegi (Faz 9)"
                                  IsOn="{Binding VisionEnabled, Mode=TwoWay}" />

                    <muxc:InfoBar Title="Gizlilik"
                                  Severity="Warning"
                                  IsOpen="{Binding VisionEnabled, Mode=OneWay}"
                                  IsClosable="False"
                                  Message="Vision acikken ekran goruntuleri secilen API saglayicisina gonderilebilir. Yerel endpoint veya vision kapali profil kullanmayi dusunun." />

                    <ToggleSwitch Header="API anahtarı gerekiyor"
                                  IsOn="{Binding RequiresApiKey, Mode=TwoWay}" />

                    <TextBox Header="API anahtarı ortam değişkeni (opsiyonel)"
                             Text="{Binding ApiKeyEnvVar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="OPENAI_API_KEY" />

                    <TextBox Header="API anahtarı header adı"
                             Text="{Binding ApiKeyHeaderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Authorization" />

                    <ComboBox Header="Yetkilendirme şeması"
                              SelectedItem="{Binding AuthScheme, Mode=TwoWay}"
                              ItemsSource="{x:Bind AuthSchemes}" />

                    <ToggleSwitch Header="Profil etkin"
                                  IsOn="{Binding IsEnabled, Mode=TwoWay}" />
                </StackPanel>
            </ScrollViewer>
        </muxc:ContentDialog>
    </Grid>
</Page>
