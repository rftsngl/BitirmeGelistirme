<Page
    x:Class="WindowsAiAssistant.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Geçmiş" Style="{StaticResource PageTitleTextBlockStyle}" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource PageSubtitleTextBlockStyle}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
            <Button Style="{ThemeResource AccentButtonStyle}" Command="{Binding RefreshCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" />
                    <TextBlock Text="Yenile" />
                </StackPanel>
            </Button>
            <Button Command="{Binding LoadToAssistantCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8A7;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" />
                    <TextBlock Text="Asistan'a Yükle" />
                </StackPanel>
            </Button>
            <muxc:ProgressRing Width="20"
                               Height="20"
                               VerticalAlignment="Center"
                               IsActive="{Binding IsRefreshing}"
                               Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="240" />
                <ColumnDefinition Width="3*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="6">
                <Grid>
                    <TextBlock Text="Liste boş. 'Yenile' ile yükleyin."
                               Margin="14"
                               Opacity="0.65"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <ListView ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              SelectionMode="Single"
                              IsItemClickEnabled="False">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="10,8" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{Binding CommandText}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Row="0" Grid.Column="1"
                                            Style="{StaticResource BadgeBorderStyle}"
                                            Margin="8,0,0,0"
                                            Background="{Binding FinalStatus, Converter={StaticResource StatusToBrushConverter}}">
                                        <TextBlock Text="{Binding FinalStatus}"
                                                   Foreground="White"
                                                   FontSize="10"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                                                Orientation="Horizontal"
                                                Spacing="10"
                                                Margin="0,2,0,0">
                                        <TextBlock Text="{Binding TimestampUtc}" FontSize="11" Opacity="0.6" />
                                        <TextBlock Text="{Binding SelectedTool}" FontSize="11" Opacity="0.7" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding SelectedItem.CommandText}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Style="{StaticResource BadgeBorderStyle}"
                                    Background="{Binding SelectedItem.FinalStatus, Converter={StaticResource StatusToBrushConverter}}">
                                <TextBlock Text="{Binding SelectedItem.FinalStatus}"
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </Border>
                            <Border Style="{StaticResource BadgeBorderStyle}"
                                    Background="{Binding SelectedItem.RiskLevel, Converter={StaticResource RiskLevelToBrushConverter}}">
                                <TextBlock Text="{Binding SelectedItem.RiskLevel}"
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <muxc:Expander Header="Outcome"
                                       IsExpanded="True"
                                       HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="6" Padding="0,4">
                                <Grid ColumnSpacing="20" RowSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="ZAMAN" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedItem.TimestampUtc}" Style="{StaticResource MetadataValueTextBlockStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="ARAÇ" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem.SelectedTool}" Style="{StaticResource MetadataValueTextBlockStyle}" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="MOD" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedItem.ExecutionMode}" Style="{StaticResource MetadataValueTextBlockStyle}" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="ONAY" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedItem.ApprovalDecision}" Style="{StaticResource MetadataValueTextBlockStyle}" />
                                </Grid>
                            </StackPanel>
                        </muxc:Expander>

                        <muxc:Expander Header="Safety"
                                       HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Stretch">
                            <Grid ColumnSpacing="20" RowSpacing="2" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="GÜVENLİK" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedItem.SafetyDisposition}" Style="{StaticResource MetadataValueTextBlockStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="RİSK" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem.RiskLevel}" Style="{StaticResource MetadataValueTextBlockStyle}" />
                            </Grid>
                        </muxc:Expander>

                        <muxc:Expander Header="Step"
                                       HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Stretch">
                            <Grid ColumnSpacing="20" RowSpacing="2" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="EXEC" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedItem.StepExecutionState}" Style="{StaticResource MetadataValueTextBlockStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="VERIFY" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem.StepVerificationState}" Style="{StaticResource MetadataValueTextBlockStyle}" />
                            </Grid>
                        </muxc:Expander>

                        <muxc:Expander Header="Runtime"
                                       HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Stretch">
                            <Grid ColumnSpacing="20" RowSpacing="2" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="DURUM" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedItem.RuntimeClosureState}" Style="{StaticResource MetadataValueTextBlockStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="TERMINAL" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem.RuntimeTerminalState}" Style="{StaticResource MetadataValueTextBlockStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="REASON" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedItem.RuntimeTerminationReason}" Style="{StaticResource MetadataValueTextBlockStyle}" />
                            </Grid>
                        </muxc:Expander>

                        <muxc:Expander Header="Mesaj"
                                       HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Stretch">
                            <TextBlock Text="{Binding SelectedItem.Message}"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Padding="0,4" />
                        </muxc:Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
