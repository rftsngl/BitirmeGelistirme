<Page
    x:Class="WindowsAiAssistant.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Gecmis ve Debug" Style="{StaticResource PageTitleTextBlockStyle}" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource PageSubtitleTextBlockStyle}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
            <Button Style="{ThemeResource AccentButtonStyle}" Command="{Binding RefreshCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" />
                    <TextBlock Text="Yenile" />
                </StackPanel>
            </Button>
            <Button Command="{Binding LoadToAssistantCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8A7;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" />
                    <TextBlock Text="Asistan'a Yukle" />
                </StackPanel>
            </Button>
            <Button Command="{Binding OpenLogFileCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8A5;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" />
                    <TextBlock Text="Logu Ac" />
                </StackPanel>
            </Button>
            <TextBox PlaceholderText="Ara (hedef metin, durum, tetikleyici...)"
                     Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     MinWidth="220"
                     VerticalAlignment="Center" />
            <muxc:ProgressRing Width="20"
                               Height="20"
                               VerticalAlignment="Center"
                               IsActive="{Binding IsRefreshing}"
                               Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" MinWidth="220" />
                <ColumnDefinition Width="1*" MinWidth="180" />
                <ColumnDefinition Width="2.2*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- Run list -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="6">
                <Grid>
                    <TextBlock Text="Liste bos. 'Yenile' ile yukleyin."
                               Margin="14"
                               Opacity="0.65"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <ListView ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="10,8" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding CommandText}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="2" />
                                        <Border Grid.Column="1"
                                                Style="{StaticResource BadgeBorderStyle}"
                                                Margin="8,0,0,0"
                                                Background="{Binding FinalStatus, Converter={StaticResource StatusToBrushConverter}}">
                                            <TextBlock Text="{Binding FinalStatus}"
                                                       Foreground="White"
                                                       FontSize="10"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding TimestampDisplay}" FontSize="11" Opacity="0.65" />
                                        <TextBlock Text=" · " FontSize="11" Opacity="0.65" />
                                        <TextBlock Text="{Binding StepCountDisplay}" FontSize="11" Opacity="0.65" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding TriggerDisplay}" FontSize="11" Opacity="0.55" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Step list -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="6">
                <Grid>
                    <TextBlock Text="Run secin."
                               Margin="14"
                               Opacity="0.65"
                               Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                    <ListView ItemsSource="{Binding Steps}"
                              SelectedItem="{Binding SelectedStep, Mode=TwoWay}"
                              SelectionMode="Single"
                              Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8,6" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}"
                                                   FontSize="11"
                                                   Opacity="0.7"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="2" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Style="{StaticResource BadgeBorderStyle}"
                                            VerticalAlignment="Center"
                                            Background="{Binding Success, Converter={StaticResource BoolToSuccessBrushConverter}}">
                                        <TextBlock Text="{Binding StatusBadge}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Step debug detail -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10"
                                Padding="4"
                                Visibility="{Binding HasStepSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding SelectedStep.Title}" FontSize="18" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Style="{StaticResource BadgeBorderStyle}"
                                    Background="{Binding SelectedStep.GateRiskDisplay, Converter={StaticResource RiskLevelToBrushConverter}}">
                                <TextBlock Text="{Binding SelectedStep.GateRisk}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <Border Style="{StaticResource BadgeBorderStyle}">
                                <TextBlock Text="{Binding SelectedStep.GateOutcome}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <muxc:Expander Header="ActionGate" IsExpanded="True">
                            <TextBlock Text="{Binding SelectedStep.GateDecision}"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </muxc:Expander>

                        <muxc:Expander Header="Parsed decision" IsExpanded="True">
                            <TextBlock Text="{Binding SelectedStep.ParsedDecision}"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </muxc:Expander>

                        <muxc:Expander Header="Action result" IsExpanded="True">
                            <TextBlock Text="{Binding SelectedStep.ActionResult}"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </muxc:Expander>

                        <muxc:Expander Header="Observation">
                            <TextBlock Text="{Binding SelectedStep.ObservationSummary}"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </muxc:Expander>

                        <muxc:Expander Header="Windows ozeti">
                            <TextBlock Text="{Binding SelectedStep.WindowsSummary}"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </muxc:Expander>

                        <muxc:Expander Header="UI element agaci">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8"
                                            Visibility="{Binding SelectedStep.UiTreeTruncated, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <FontIcon Glyph="&#xE7BA;"
                                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                                              FontSize="13"
                                              Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    <TextBlock Text="UI agaci kesilmis" FontSize="12" Opacity="0.8" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedStep.UiTreeCharInfo}"
                                           FontSize="11"
                                           Opacity="0.65"
                                           Visibility="{Binding SelectedStep.UiTreeCharInfo, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                                <TextBlock Text="{Binding SelectedStep.UiTreeSummary}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                                <Button Content="UI Agaci Kopyala"
                                        Command="{Binding CopyUiTreeCommand}"
                                        Visibility="{Binding SelectedStep.UiTreeCharInfo, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                            </StackPanel>
                        </muxc:Expander>

                        <muxc:Expander Header="Screenshot">
                            <StackPanel Spacing="8">
                                <Image Source="{Binding SelectedStep.ScreenshotPath, Converter={StaticResource FilePathToImageSourceConverter}}"
                                       MaxHeight="220"
                                       Stretch="Uniform"
                                       Visibility="{Binding SelectedStep.HasScreenshot, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock Text="{Binding SelectedStep.ScreenshotPath}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Opacity="0.8" />
                                <Button Content="Dosyayi goster"
                                        Command="{Binding OpenScreenshotCommand}"
                                        Visibility="{Binding SelectedStep.HasScreenshot, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </muxc:Expander>

                        <muxc:Expander Header="LLM raw output">
                            <TextBlock Text="{Binding SelectedStep.LlmRawOutput}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </muxc:Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
