<Page
    x:Class="WindowsAiAssistant.App.Views.UnifiedSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:ps="using:WindowsAiAssistant.App.ProviderSettings"
    xmlns:cfg="using:WindowsAiAssistant.App.Configuration">

    <Page.Resources>
        <DataTemplate x:Key="SettingsChoiceItemTemplate" x:DataType="cfg:SettingsChoice">
            <StackPanel Spacing="2" Padding="0,2">
                <TextBlock Text="{x:Bind Display}" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind Description}" Style="{StaticResource SettingDescriptionTextBlockStyle}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="{StaticResource PagePadding}"
          RowSpacing="16"
          ColumnSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="200" MaxWidth="300" Width="0.28*" />
            <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Spacing="4"
                    HorizontalAlignment="Stretch">
            <TextBlock Text="Ayarlar" Style="{StaticResource PageTitleTextBlockStyle}" />
            <TextBlock Text="Yapay zeka bağlantısı, sesli asistan ve güvenlik tercihlerinizi buradan yönetin."
                       Style="{StaticResource PageSubtitleTextBlockStyle}" />
        </StackPanel>

        <Border Grid.Row="1"
                Grid.Column="0"
                Style="{StaticResource SettingsCardBorderStyle}"
                Padding="14"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="8">
                    <TextBlock Text="Kategoriler" Style="{StaticResource SectionTitleTextBlockStyle}" />
                    <Button Style="{StaticResource SettingsNavButtonStyle}" Click="ShowModelSection_OnClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE7B5;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14" />
                            <TextBlock Text="Yapay zeka modeli" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SettingsNavButtonStyle}" Click="ShowAudioSection_OnClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE1D6;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14" />
                            <TextBlock Text="Sesli asistan" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SettingsNavButtonStyle}" Click="ShowSecuritySection_OnClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE72E;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14" />
                            <TextBlock Text="Güvenlik ve onaylar" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SettingsNavButtonStyle}" Click="ShowDeveloperSection_OnClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE950;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14" />
                            <TextBlock Text="Geliştirici" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="1"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="12"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Stretch">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Şu an kullanılan model" Style="{StaticResource LabelTextBlockStyle}" />
                        <TextBlock Text="{Binding ProviderStatus.DisplayName, Mode=OneWay}"
                                   FontWeight="SemiBold"
                                   TextWrapping="WrapWholeWords" />
                        <TextBlock Text="{Binding ProviderStatus.Model, Mode=OneWay}"
                                   FontSize="12"
                                   Opacity="0.7"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Border>

                <Button Grid.Row="2"
                        Style="{ThemeResource AccentButtonStyle}"
                        Click="SaveAppSettings_OnClick"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14" />
                        <TextBlock Text="Değişiklikleri kaydet" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer x:Name="SettingsScrollViewer"
                      Grid.Row="1"
                      Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalAlignment="Stretch">
            <StackPanel Spacing="14"
                        HorizontalAlignment="Stretch">

                <!-- ═══ BÖLÜM 1: MODEL VE BAĞLANTI ═══ -->
                <muxc:Expander x:Name="ModelSection"
                               Style="{StaticResource SettingsExpanderStyle}"
                               IsExpanded="True">
                    <muxc:Expander.Header>
                        <TextBlock Text="Yapay zeka modeli" Style="{StaticResource SettingTitleTextBlockStyle}" />
                    </muxc:Expander.Header>
                    <StackPanel Spacing="12" HorizontalAlignment="Stretch">

                    <TextBlock Style="{StaticResource SettingsSectionIntroTextBlockStyle}"
                               Text="Asistanın hangi yapay zeka servisini kullanacağını seçin. Bulut servisler için API anahtarı, yerel modeller için bilgisayarınızda çalışan sunucu adresi gerekir." />

                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE7B5;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock>
                                    <Run Text="Seçili model: " Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Run Text="{Binding ProviderStatus.DisplayName, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding ProviderStatus.Kind, Mode=OneWay}" FontSize="11" Opacity="0.7" />
                                    <TextBlock Text="·" FontSize="11" Opacity="0.45" />
                                    <TextBlock Text="{Binding ProviderStatus.Model, Mode=OneWay}" FontSize="11" Opacity="0.85" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="2" Style="{StaticResource BadgeBorderStyle}"
                                    Background="{Binding ProviderStatus.ReadyBadge, Mode=OneWay, Converter={StaticResource StatusToBrushConverter}}">
                                <TextBlock Text="{Binding ProviderStatus.ReadyBadge, Mode=OneWay}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Profil işlemleri" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource SettingDescriptionTextBlockStyle}"
                                   Text="Hazır şablonlardan birini seçebilir veya kendi profilinizi oluşturabilirsiniz." />
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="120" />
                                <ColumnDefinition Width="*" MinWidth="90" />
                                <ColumnDefinition Width="*" MinWidth="90" />
                                <ColumnDefinition Width="*" MinWidth="90" />
                                <ColumnDefinition Width="*" MinWidth="100" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" Grid.Column="0" Style="{ThemeResource AccentButtonStyle}" Click="NewProfile_OnClick" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" />
                                    <TextBlock Text="Yeni profil" TextWrapping="NoWrap" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="0" Grid.Column="1" Click="PresetOpenAi_OnClick" HorizontalAlignment="Stretch" ToolTipService.ToolTip="OpenAI (GPT) profili oluştur">
                                <TextBlock Text="OpenAI" />
                            </Button>
                            <Button Grid.Row="0" Grid.Column="2" Click="PresetGemini_OnClick" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Google Gemini profili oluştur">
                                <TextBlock Text="Gemini" />
                            </Button>
                            <Button Grid.Row="0" Grid.Column="3" Click="PresetOllama_OnClick" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Bilgisayarınızdaki Ollama sunucusu">
                                <TextBlock Text="Ollama" />
                            </Button>
                            <Button Grid.Row="0" Grid.Column="4" Click="PresetLmStudio_OnClick" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Bilgisayarınızdaki LM Studio sunucusu">
                                <TextBlock Text="LM Studio" />
                            </Button>
                            <Button Grid.Row="1" Grid.Column="0" Click="EditProfile_OnClick" IsEnabled="{Binding EditEnabled}" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE70F;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" />
                                    <TextBlock Text="Düzenle" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="1" Grid.Column="1" Click="DeleteProfile_OnClick" IsEnabled="{Binding DeleteEnabled}" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" />
                                    <TextBlock Text="Sil" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <muxc:InfoBar Title="Bilgi" IsClosable="False" Severity="Informational"
                                  Message="{Binding StatusMessage, Mode=OneWay}" IsOpen="True"
                                  Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />

                    <Grid ColumnSpacing="16" MinHeight="280" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="240" />
                            <ColumnDefinition Width="1.3*" MinWidth="280" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="6" MinHeight="280" HorizontalAlignment="Stretch">
                            <ListView x:Name="ProfilesListBox" ItemsSource="{Binding ProfileItems}"
                                      SelectionChanged="ProfilesListBox_OnSelectionChanged" SelectionMode="Single"
                                      HorizontalAlignment="Stretch">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="10,8" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="ps:ProfileListItem">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Bind DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource BadgeBorderStyle}" Margin="6,0,0,0"
                                                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                    Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{x:Bind ActiveBadge, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                                <TextBlock Text="{x:Bind Kind}" FontSize="11" Opacity="0.65" />
                                                <TextBlock Text="·" FontSize="11" Opacity="0.45" />
                                                <TextBlock Text="{x:Bind Model}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                                <Border Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource AccentFillColorTertiaryBrush}" Padding="6,1,6,2"
                                                        Visibility="{x:Bind ShowKeyBadge, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{x:Bind KeyBadgeText, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" MinHeight="280" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="14" HorizontalAlignment="Stretch">
                                    <muxc:InfoBar Title="Profil kullanılamıyor" Severity="Warning" IsClosable="False"
                                                  IsOpen="{Binding ShowDisabledBanner, Mode=OneWay}"
                                                  Message="{Binding DisabledBannerText, Mode=OneWay}" />

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource AccentFillColorTertiaryBrush}">
                                            <TextBlock Text="{Binding DetailOriginLabel, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>

                                    <Grid ColumnSpacing="20" RowSpacing="6" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="Görünen ad" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DetailDisplayName, Mode=OneWay}" Style="{StaticResource MetadataValueTextBlockStyle}" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="Servis türü" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DetailKind, Mode=OneWay}" Style="{StaticResource MetadataValueTextBlockStyle}" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="Sunucu adresi"
                                                   Visibility="{x:Bind AppVM.DeveloperModeEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DetailBaseUrl, Mode=OneWay}" Style="{StaticResource MetadataValueTextBlockStyle}"
                                                   Visibility="{x:Bind AppVM.DeveloperModeEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="Model adı" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DetailModel, Mode=OneWay}" Style="{StaticResource MetadataValueTextBlockStyle}" />
                                        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="Endpoint"
                                                   Visibility="{x:Bind AppVM.DeveloperModeEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DetailEndpointPath, Mode=OneWay}" Style="{StaticResource MetadataValueTextBlockStyle}"
                                                   Visibility="{x:Bind AppVM.DeveloperModeEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="Sıcaklık"
                                                   Visibility="{x:Bind AppVM.DeveloperModeEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DetailTemperature, Mode=OneWay}" Style="{StaticResource MetadataValueTextBlockStyle}"
                                                   Visibility="{x:Bind AppVM.DeveloperModeEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="Max token"
                                                   Visibility="{x:Bind AppVM.DeveloperModeEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding DetailMaxTokens, Mode=OneWay}" Style="{StaticResource MetadataValueTextBlockStyle}"
                                                   Visibility="{x:Bind AppVM.DeveloperModeEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="Ekran görüntüsü"
                                                   Visibility="{x:Bind AppVM.DeveloperModeEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding DetailVisionEnabled, Mode=OneWay}" Style="{StaticResource MetadataValueTextBlockStyle}"
                                                   Visibility="{x:Bind AppVM.DeveloperModeEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="API anahtarı gerekli"
                                                   Visibility="{x:Bind AppVM.DeveloperModeEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding DetailRequiresApiKey, Mode=OneWay}" Style="{StaticResource MetadataValueTextBlockStyle}"
                                                   Visibility="{x:Bind AppVM.DeveloperModeEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="Profil etkin"
                                                   Visibility="{x:Bind AppVM.DeveloperModeEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding DetailIsEnabled, Mode=OneWay}" Style="{StaticResource MetadataValueTextBlockStyle}"
                                                   Visibility="{x:Bind AppVM.DeveloperModeEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Style="{ThemeResource AccentButtonStyle}" Click="SetActive_OnClick" IsEnabled="{Binding SetActiveEnabled}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE73E;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" />
                                                <TextBlock Text="{Binding SetActiveButtonText, Mode=OneWay}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Click="TestConnection_OnClick" IsEnabled="{Binding TestConnectionEnabled}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE968;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" />
                                                <TextBlock Text="Bağlantıyı dene" />
                                            </StackPanel>
                                        </Button>
                                        <muxc:ProgressRing Width="20" Height="20" VerticalAlignment="Center"
                                                           IsActive="{Binding IsTestingConnection, Mode=OneWay}"
                                                           Visibility="{Binding IsTestingConnection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>

                                    <Border Style="{StaticResource CardBorderStyle}" Padding="12,10"
                                            Visibility="{Binding HasLastConnectionTest, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Spacing="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding LastConnectionTest.Title, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Border Grid.Column="1" Style="{StaticResource BadgeBorderStyle}"
                                                        Background="{Binding LastConnectionTest.Title, Mode=OneWay, Converter={StaticResource StatusToBrushConverter}}">
                                                    <TextBlock Text="{Binding LastConnectionTest.DurationDisplay, Mode=OneWay}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding LastConnectionTest.Message, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.85" />
                                            <TextBlock FontSize="11" Opacity="0.65">
                                                <Run Text="Son test: " />
                                                <Run Text="{Binding LastConnectionTest.CompletedDisplay, Mode=OneWay}" />
                                            </TextBlock>
                                            <Button Content="Asistan'da dene" Click="TryInAssistant_OnClick"
                                                    IsEnabled="{Binding CanTryInAssistant, Mode=OneWay}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <muxc:Expander Header="API anahtarı" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                   Visibility="{Binding KeyAreaVisibility}">
                                        <StackPanel Spacing="10" Padding="0,4">
                                            <TextBlock Style="{StaticResource SettingDescriptionTextBlockStyle}"
                                                       Text="Bulut servisler için hesabınızdan aldığınız gizli anahtarı buraya yapıştırın. Anahtar bilgisayarınızda şifreli saklanır." />
                                            <Border Style="{StaticResource CardBorderStyle}" Padding="12,8"
                                                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                    Visibility="{Binding HasSavedKeyForCurrent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <FontIcon Glyph="&#xE73E;" FontFamily="{StaticResource SymbolThemeFontFamily}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontSize="16" VerticalAlignment="Center" />
                                                    <StackPanel Spacing="0">
                                                        <TextBlock Text="Kayıtlı anahtar mevcut" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding SavedKeyMask, Mode=OneWay}" FontFamily="Consolas" FontSize="12" Opacity="0.85" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource CardBorderStyle}" Padding="12,8"
                                                    Visibility="{Binding HasSavedKeyForCurrent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <FontIcon Glyph="&#xE7BA;" FontFamily="{StaticResource SymbolThemeFontFamily}" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="16" VerticalAlignment="Center" />
                                                    <TextBlock Text="Henüz API anahtarı kaydedilmedi." VerticalAlignment="Center" Opacity="0.85" />
                                                </StackPanel>
                                            </Border>
                                            <PasswordBox x:Name="ApiKeyPasswordBox" PasswordChanged="ApiKeyPasswordBox_OnPasswordChanged"
                                                         PlaceholderText="sk-..." Header="Yeni API anahtarı" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Style="{ThemeResource AccentButtonStyle}" Click="SaveKey_OnClick" IsEnabled="{Binding KeySaveRemoveEnabled}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE74E;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" />
                                                        <TextBlock Text="Anahtarı kaydet" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Click="RemoveKey_OnClick" IsEnabled="{Binding HasSavedKeyForCurrent, Mode=OneWay}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE74D;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" />
                                                        <TextBlock Text="Kaldır" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </muxc:Expander>

                                    <muxc:InfoBar Title="API anahtarı gerekmiyor" Severity="Informational" IsClosable="False"
                                                  IsOpen="{Binding ShowNoKeyMessage, Mode=OneWay}"
                                                  Message="Bu profil bilgisayarınızda çalışan yerel bir sunucuya bağlanır; ayrı API anahtarı gerekmez." />
                                </StackPanel>
                        </Border>
                    </Grid>
                    </StackPanel>
                </muxc:Expander>

                <!-- ═══ BÖLÜM 2: SESLİ ASİSTAN ═══ -->
                <muxc:Expander x:Name="AudioSection"
                               Style="{StaticResource SettingsExpanderStyle}"
                               IsExpanded="False">
                    <muxc:Expander.Header>
                        <TextBlock Text="Sesli asistan" Style="{StaticResource SettingTitleTextBlockStyle}" />
                    </muxc:Expander.Header>
                    <StackPanel Spacing="12" HorizontalAlignment="Stretch">

                    <TextBlock Style="{StaticResource SettingsSectionIntroTextBlockStyle}"
                               Text="Asistanı arka planda çalıştırın, kısayol veya uyandırma kelimesiyle komut verin. Konuşmanız metne çevrilir, yanıt isteğe bağlı sesli okunur." />

                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Genel davranış" FontWeight="SemiBold" Margin="0,0,0,8" />

                            <Grid ColumnSpacing="16" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Arka planda çalış" Style="{StaticResource SettingTitleTextBlockStyle}" />
                                    <TextBlock Text="Uygulama kapatıldığında sistem tepsisine iner; komut vermeye devam edebilirsiniz."
                                               Style="{StaticResource SettingDescriptionTextBlockStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding BackgroundModeEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource SettingDividerStyle}" />

                            <Grid ColumnSpacing="16" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Açılışta tepsiye küçült" Style="{StaticResource SettingTitleTextBlockStyle}" />
                                    <TextBlock Text="Uygulama başlarken ana pencere yerine doğrudan tepsi simgesi görünür."
                                               Style="{StaticResource SettingDescriptionTextBlockStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding StartMinimizedToTray, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource SettingDividerStyle}" />

                            <Grid ColumnSpacing="16" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Windows ile birlikte başlat" Style="{StaticResource SettingTitleTextBlockStyle}" />
                                    <TextBlock Text="Bilgisayar açıldığında asistan otomatik olarak arka planda başlar."
                                               Style="{StaticResource SettingDescriptionTextBlockStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding StartWithWindows, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource SettingDividerStyle}" />

                            <Grid ColumnSpacing="16" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Klavye kısayolu" Style="{StaticResource SettingTitleTextBlockStyle}" />
                                    <TextBlock Text="Her yerden bu tuş kombinasyonuyla sesli komut penceresini açabilirsiniz."
                                               Style="{StaticResource SettingDescriptionTextBlockStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding GlobalHotKeyEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBox Header="Kısayol tuşları" Text="{Binding GlobalHotKey, Mode=TwoWay}"
                                     PlaceholderText="Ctrl+Alt+A" Margin="0,0,0,8" HorizontalAlignment="Stretch" />
                            <TextBlock Text="Örnek: Ctrl+Alt+A — değişikliklerin uygulanması için kaydedip yeniden başlatın."
                                       Style="{StaticResource SettingDescriptionTextBlockStyle}" Margin="0,0,0,8" />
                            <Border Style="{StaticResource SettingDividerStyle}" />

                            <Grid ColumnSpacing="16" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Yanıtları sesli oku" Style="{StaticResource SettingTitleTextBlockStyle}" />
                                    <TextBlock Text="Asistan cevabını hoparlörden okur (TTS)."
                                               Style="{StaticResource SettingDescriptionTextBlockStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding TextToSpeechEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource SettingDividerStyle}" />

                            <TextBox Header="Konuşma dili" Text="{Binding SpeechLanguage, Mode=TwoWay}"
                                     PlaceholderText="tr-TR" HorizontalAlignment="Stretch" />
                            <TextBlock Text="Türkçe için tr-TR kullanın. Vosk ve sesli okuma bu dile göre ayarlanır."
                                       Style="{StaticResource SettingDescriptionTextBlockStyle}" Margin="0,4,0,8" />

                            <NumberBox Header="Dinleme süresi (saniye)" Value="{Binding SpeechListenTimeoutSeconds, Mode=TwoWay}"
                                       Minimum="3" Maximum="120" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch" />
                            <TextBlock Text="Komut penceresi açıldıktan sonra mikrofonun kaç saniye dinleyeceğini belirler."
                                       Style="{StaticResource SettingDescriptionTextBlockStyle}" Margin="0,4,0,8" />

                            <NumberBox Header="Sonuç penceresi kapanma süresi (saniye)" Value="{Binding OverlayAutoCloseSeconds, Mode=TwoWay}"
                                       Minimum="3" Maximum="120" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch" />
                            <TextBlock Text="İşlem bittikten sonra küçük sonuç penceresinin ekranda kalma süresi."
                                       Style="{StaticResource SettingDescriptionTextBlockStyle}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Mikrofon ve komut dinleme" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource SettingDescriptionTextBlockStyle}"
                                       Text="Overlay açıldığında komutunuzu dinleyen motor. Türkçe için Vosk önerilir; Windows paketi gerekmez." />

                            <muxc:InfoBar Severity="Informational"
                                          IsOpen="True"
                                          IsClosable="False"
                                          Title="Mikrofon izni"
                                          Message="{Binding MicrophonePermissionSummary}" />
                            <Button Content="Mikrofon iznini iste"
                                    Command="{Binding RequestMicrophonePermissionCommand}"
                                    HorizontalAlignment="Left" />

                            <ComboBox Header="Komut dinleme motoru"
                                      ItemsSource="{x:Bind AppVM.SpeechEngineChoices, Mode=OneWay}"
                                      SelectedItem="{Binding SelectedSpeechEngine, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource SettingsChoiceItemTemplate}"
                                      HorizontalAlignment="Stretch" />

                            <muxc:InfoBar IsOpen="True"
                                          IsClosable="False"
                                          Severity="Informational"
                                          Title="Komut dinleme"
                                          Message="{Binding SpeechLanguageSummary}" />
                            <TextBlock Text="{Binding SttEngineSummary}"
                                       Style="{StaticResource SettingDescriptionTextBlockStyle}" />

                            <ComboBox Header="Mikrofon"
                                      ItemsSource="{Binding MicrophoneOptions}"
                                      SelectedItem="{Binding SelectedMicrophone, Mode=TwoWay}"
                                      DisplayMemberPath="Display"
                                      HorizontalAlignment="Stretch" />
                            <TextBlock Text="Yanlış mikrofon seçiliyse ses algılanmayabilir."
                                       Style="{StaticResource SettingDescriptionTextBlockStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Uyandırma kelimesi (isteğe bağlı)" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource SettingDescriptionTextBlockStyle}"
                                       Text="Klavye kısayolu (Ctrl+Alt+A) her zaman kullanılabilir. Uyandırma kelimesi Vosk ile tamamen yerel çalışır; hesap veya API anahtarı gerekmez." />

                            <muxc:InfoBar IsOpen="True"
                                          IsClosable="False"
                                          Severity="Informational"
                                          Title="Uyandırma hizmeti"
                                          Message="{Binding WakeWordServiceSummary}" />

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Uyandırma kelimesini dinle" Style="{StaticResource SettingTitleTextBlockStyle}" />
                                    <TextBlock Text="Kapalıysa yalnızca klavye kısayolu veya tepsi menüsü ile komut verebilirsiniz."
                                               Style="{StaticResource SettingDescriptionTextBlockStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsOn="{Binding WakeWordEnabled, Mode=TwoWay}"
                                              IsEnabled="{Binding IsWakeWordServiceAvailable}"
                                              VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Spacing="12"
                                        Visibility="{Binding WakeWordEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ComboBox Header="Hangi kelimeyi dinlesin?"
                                          ItemsSource="{x:Bind AppVM.WakeWordChoices, Mode=OneWay}"
                                          SelectedItem="{Binding SelectedWakeWord, Mode=TwoWay}"
                                          ItemTemplate="{StaticResource SettingsChoiceItemTemplate}"
                                          HorizontalAlignment="Stretch" />
                                <TextBlock Text="Seçtiğiniz kelimeyi söylediğinizde sesli asistan açılır. Gürültülü ortamlarda yanlış uyandırma olabilir."
                                           Style="{StaticResource SettingDescriptionTextBlockStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </muxc:Expander>

                <!-- ═══ BÖLÜM 3: GÜVENLİK VE ONAYLAR ═══ -->
                <muxc:Expander x:Name="SecuritySection"
                               Style="{StaticResource SettingsExpanderStyle}"
                               IsExpanded="False">
                    <muxc:Expander.Header>
                        <TextBlock Text="Güvenlik ve onaylar" Style="{StaticResource SettingTitleTextBlockStyle}" />
                    </muxc:Expander.Header>
                    <StackPanel Spacing="12" HorizontalAlignment="Stretch">

                    <TextBlock Style="{StaticResource SettingsSectionIntroTextBlockStyle}"
                               Text="Asistanın bilgisayarınızda yapabileceği işlemlerin risk seviyesine göre nasıl davranacağını belirleyin." />

                    <Border Style="{StaticResource SettingsCardBorderStyle}">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Günlük işlemler" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource SettingDescriptionTextBlockStyle}"
                                           Text="Pencere açma, metin yazma, tıklama gibi sıradan ve geri dönüşü kolay işlemler." />
                                <ComboBox ItemsSource="{x:Bind AppVM.RiskHandlingChoices, Mode=OneWay}"
                                          SelectedItem="{Binding SelectedNormalHandling, Mode=TwoWay}"
                                          ItemTemplate="{StaticResource SettingsChoiceItemTemplate}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Dikkat gerektiren işlemler" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource SettingDescriptionTextBlockStyle}"
                                           Text="Dosya silme, sistem ayarı değiştirme veya belirsiz koordinata tıklama gibi daha riskli adımlar." />
                                <ComboBox ItemsSource="{x:Bind AppVM.RiskHandlingChoices, Mode=OneWay}"
                                          SelectedItem="{Binding SelectedSensitiveHandling, Mode=TwoWay}"
                                          ItemTemplate="{StaticResource SettingsChoiceItemTemplate}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Tehlikeli işlemler" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource SettingDescriptionTextBlockStyle}"
                                           Text="Kalıcı silme, disk biçimlendirme veya geri alınamaz sistem komutları." />
                                <ComboBox ItemsSource="{x:Bind AppVM.RiskHandlingChoices, Mode=OneWay}"
                                          SelectedItem="{Binding SelectedDestructiveHandling, Mode=TwoWay}"
                                          ItemTemplate="{StaticResource SettingsChoiceItemTemplate}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <Border Style="{StaticResource SettingDividerStyle}" />

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="«Bu oturumda hep izin ver» seçeneği" Style="{StaticResource SettingTitleTextBlockStyle}" />
                                    <TextBlock Text="Onay ekranında aynı tür işlemler için tekrar tekrar sormadan oturum boyunca izin vermenizi sağlar."
                                               Style="{StaticResource SettingDescriptionTextBlockStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding AllowSessionRemember, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource SettingDividerStyle}" />

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Sesli onay" Style="{StaticResource SettingTitleTextBlockStyle}" />
                                    <TextBlock Text="Onay beklerken «evet» veya «hayır» diyerek de cevap verebilirsiniz."
                                               Style="{StaticResource SettingDescriptionTextBlockStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding VoiceApprovalEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </muxc:Expander>

                <!-- ═══ BÖLÜM 4: GELİŞTİRİCİ MODU ═══ -->
                <muxc:Expander x:Name="DeveloperSection"
                               Style="{StaticResource SettingsExpanderStyle}"
                               IsExpanded="False">
                    <muxc:Expander.Header>
                        <TextBlock Text="Geliştirici" Style="{StaticResource SettingTitleTextBlockStyle}" />
                    </muxc:Expander.Header>
                    <StackPanel Spacing="12" HorizontalAlignment="Stretch">

                    <TextBlock Style="{StaticResource SettingsSectionIntroTextBlockStyle}"
                               Text="Teknik ayrıntıları görmek ve gelişmiş otomasyon seçeneklerini ayarlamak için kullanın." />

                    <Border Style="{StaticResource DeveloperPanelBorderStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Geliştirici modu" Style="{StaticResource SettingTitleTextBlockStyle}" />
                                    <TextBlock Text="Açıkken sohbette model çıktıları, yapılan işlem ayrıntıları ve teknik loglar görünür."
                                               Style="{StaticResource SettingDescriptionTextBlockStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding DeveloperModeEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Spacing="12" Visibility="{Binding DeveloperModeEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border Style="{StaticResource SettingDividerStyle}" />
                                <TextBlock Text="Gelişmiş otomasyon" FontWeight="SemiBold" />
                                <TextBlock Text="Bu seçeneklerin etkinleşmesi için uygulamayı yeniden başlatmanız gerekebilir."
                                           Style="{StaticResource SettingDescriptionTextBlockStyle}" />

                                <Border Style="{StaticResource SettingDividerStyle}" />
                                <TextBlock Text="Çalışma bütçesi" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox Header="Adım limiti"
                                               Value="{Binding MaxSteps, Mode=TwoWay}"
                                               Minimum="1"
                                               Maximum="40"
                                               SpinButtonPlacementMode="Inline"
                                               HorizontalAlignment="Stretch" />
                                    <NumberBox Grid.Column="1"
                                               Header="Prompt geçmişi"
                                               Value="{Binding MaxPriorStepsInPrompt, Mode=TwoWay}"
                                               Minimum="1"
                                               Maximum="20"
                                               SpinButtonPlacementMode="Inline"
                                               HorizontalAlignment="Stretch" />
                                </Grid>
                                <TextBlock Text="Uzun görevlerde adım limitini artırın; prompt geçmişi yüksekse model daha fazla önceki denemeyi görür."
                                           Style="{StaticResource SettingDescriptionTextBlockStyle}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Tarayıcı erişilebilirlik desteği" Style="{StaticResource SettingTitleTextBlockStyle}" />
                                        <TextBlock Text="Chrome ve benzeri uygulamalarda arayüz öğelerinin daha iyi okunmasını sağlar."
                                                   Style="{StaticResource SettingDescriptionTextBlockStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsOn="{Binding EnableChromiumAccessibility, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Eski uygulama desteği (UIA2)" Style="{StaticResource SettingTitleTextBlockStyle}" />
                                        <TextBlock Text="Modern arayüz okunamadığında eski Windows uygulamalarına geçiş yapar."
                                                   Style="{StaticResource SettingDescriptionTextBlockStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsOn="{Binding EnableUia2Fallback, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>

                                <NumberBox Header="UIA2 geçiş eşiği (öğe sayısı)" Value="{Binding Uia2FallbackMinElements, Mode=TwoWay}"
                                           Minimum="1" Maximum="20" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch" />
                                <TextBlock Text="Ekranda bu kadar az öğe bulunursa eski otomasyon yöntemine geçilir."
                                           Style="{StaticResource SettingDescriptionTextBlockStyle}" />

                                <Border Style="{StaticResource SettingDividerStyle}" />
                                <TextBlock Text="Gelişmiş ses" FontWeight="SemiBold" />
                                <TextBlock Text="Normal kullanımda gerekmez. Whisper yalnızca geliştirici modunda burada yapılandırılır."
                                           Style="{StaticResource SettingDescriptionTextBlockStyle}" />
                                <TextBox Header="Whisper model dosyası yolu" Text="{Binding WhisperModelPath, Mode=TwoWay}"
                                         PlaceholderText="C:\Models\ggml-base.bin"
                                         Visibility="{Binding IsWhisperEngine, Converter={StaticResource BoolToVisibilityConverter}}"
                                         HorizontalAlignment="Stretch" />
                                <TextBox Header="Vosk uyandırma model klasörü (isteğe bağlı)" Text="{Binding VoskModelPath, Mode=TwoWay}"
                                         PlaceholderText="Bos birakirsaniz model otomatik indirilir"
                                         HorizontalAlignment="Stretch" />
                                <Button Click="OpenCapabilities_OnClick"
                                        HorizontalAlignment="Left"
                                        ToolTipService.ToolTip="Asistanın kullanabildiği tüm işlem türlerini listeler">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE950;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="13" />
                                        <TextBlock Text="Desteklenen yetenekler" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </muxc:Expander>

            </StackPanel>
        </ScrollViewer>

        <ContentDialog x:Name="ProfileEditorDialog"
                        Title="{Binding EditingTitle}"
                        PrimaryButtonText="Kaydet" SecondaryButtonText="İptal" DefaultButton="Primary"
                        PrimaryButtonClick="ProfileEditorDialog_OnPrimaryButtonClick"
                        SecondaryButtonClick="ProfileEditorDialog_OnSecondaryButtonClick">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                <StackPanel Spacing="10" MinWidth="360" MaxWidth="560" DataContext="{Binding EditingDraft}">
                    <muxc:InfoBar x:Name="ProfileEditorErrorBar" Title="Doğrulama" Severity="Error" IsClosable="False" IsOpen="False" />
                    <TextBox Header="Kimlik (Id)" Text="{Binding Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ör. my-openai" />
                    <TextBox Header="Görünen Ad" Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ör. OpenAI (kişisel)" />
                    <ComboBox Header="Sağlayıcı türü" SelectedItem="{Binding Kind, Mode=TwoWay}" ItemsSource="{x:Bind ProviderKinds}" />
                    <TextBox Header="Base URL" Text="{Binding BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="https://api.openai.com/v1" />
                    <TextBox Header="Model" Text="{Binding Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="gpt-4.1-mini" />
                    <ComboBox Header="Endpoint stili" SelectedItem="{Binding EndpointStyle, Mode=TwoWay}" ItemsSource="{x:Bind EndpointStyles}" />
                    <TextBox Header="Endpoint yolu" Text="{Binding EndpointPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="chat/completions" />
                    <TextBox Header="Temperature (opsiyonel)" Text="{Binding TemperatureText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="0.7" />
                    <TextBox Header="Max tokens (opsiyonel)" Text="{Binding MaxTokensText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="4096" />
                    <NumberBox Header="İstek zaman aşımı (sn)" Value="{Binding RequestTimeoutSeconds, Mode=TwoWay}" Minimum="5" Maximum="600" SpinButtonPlacementMode="Inline" />
                    <ToggleSwitch Header="Vision desteği" IsOn="{Binding VisionEnabled, Mode=TwoWay}" />
                    <muxc:InfoBar Title="Gizlilik" Severity="Warning" IsOpen="{Binding VisionEnabled, Mode=OneWay}" IsClosable="False"
                                  Message="Vision açıkken ekran görüntüleri seçilen API sağlayıcısına gönderilebilir. Yerel endpoint veya vision kapalı profil kullanmayı düşünün." />
                    <ToggleSwitch Header="API anahtarı gerekiyor" IsOn="{Binding RequiresApiKey, Mode=TwoWay}" />
                    <TextBox Header="API anahtarı ortam değişkeni (opsiyonel)" Text="{Binding ApiKeyEnvVar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="OPENAI_API_KEY" />
                    <TextBox Header="API anahtarı header adı" Text="{Binding ApiKeyHeaderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Authorization" />
                    <ComboBox Header="Yetkilendirme şeması" SelectedItem="{Binding AuthScheme, Mode=TwoWay}" ItemsSource="{x:Bind AuthSchemes}" />
                    <ToggleSwitch Header="Profil etkin" IsOn="{Binding IsEnabled, Mode=TwoWay}" />
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Page>
