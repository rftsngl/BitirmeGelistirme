{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/WindowsAiAssistant.sln",
        "-v",
        "minimal"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$msCompile",
      "options": {
        "env": {
          "BITIRME_WORKSPACE": "${workspaceFolder}"
        }
      }
    },
    {
      "label": "run",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/src/WindowsAiAssistant.App/WindowsAiAssistant.App.csproj"
      ],
      "dependsOn": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "options": {
        "env": {
          "BITIRME_WORKSPACE": "${workspaceFolder}"
        }
      }
    },
    {
      "label": "clean build output (LocalAppData)",
      "type": "shell",
      "command": "Remove-Item -Recurse -Force \"$env:LOCALAPPDATA\\WindowsAiAssistantBuild\" -ErrorAction SilentlyContinue; Write-Host 'Build cache temizlendi.'",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "add antivirus exclusions (admin)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Add-DevAntivirusExclusions.ps1"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
