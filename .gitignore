# =============================================================================
# Windows AI Assistant — .gitignore
# Repo: kaynak kod, test, release scriptleri, kurulum tanimi.
# Disarida: build ciktisi, yerel modeller, gizliler, kisisel/taslak dosyalar.
# =============================================================================

# --- Derleme ve publish ciktisi ---
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
out/
publish/
publish-*/
AppPackages/
BundleArtifacts/
artifacts/
/dist/

# --- IDE / editor ---
.vs/
.idea/
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
*.user
*.rsuser
*.suo
*.userosscache
*.sln.docstates
.cursor/
.cursorignore
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json

# --- MSBuild / WinUI gecici ---
*.binlog
msbuild.log
msbuild.err
UpgradeLog*.XML
UpgradeLog*.htm
xaml-build.log*
xaml_stdout.txt
xaml_stderr.txt
*.xbf
*.pri
*.appx
*.appxbundle
*.msix
*.msixbundle

# --- Test / coverage ---
TestResults/
*.trx
*.coverage
*.coveragexml

# --- NuGet paketleri (restore ile gelir) ---
*.nupkg
*.snupkg
packages/
!packages/build/
project.lock.json

# --- Log ve debug ---
*.log
debug-*.log

# --- Gizliler ve yerel yapilandirma ---
.env
.env.*
**/appsettings.Development.json
**/appsettings.Local.json
!**/appsettings.Local.json.example
provider-settings.json
secrets.json
*.pfx
*.p12

# --- Ses modelleri (buyuk; Ayarlar veya script ile indirilir) ---
# Dikkat: kok "models/" kullanmayin — src/**/Models/ kaynak kodunu etkiler.
/models/
/whisper/
**/Assets/Models/
vosk-model*/
ggml-*.bin
*.gguf

# --- Yerel deneme / tek seferlik araclar ---
.tmp-*/
scripts/SpeechLangDiag/
scripts/update-plan-checkboxes.py

# --- Kisisel / bitirme / ic taslak dokumanlar (repoda gerekmez) ---
BitirmeRapor/
Rapor/
docs/

# --- Isletim sistemi ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
